#!/usr/bin/env bash

# When Bash reads this program from stdin, preserve the unread application body
# in a real file and re-execute it. This makes curl | sudo bash installs able to
# copy the complete application to its permanent location.
if [[ -z ${BASH_SOURCE[0]:-} ]]; then
  a2dpilot_stream_tmp=$(mktemp "/tmp/a2dpilot-stream.XXXXXX") || exit 1
  trap 'rm -f -- "$a2dpilot_stream_tmp"' EXIT
  {
    printf '%s\n' '#!/usr/bin/env bash'
    dd status=none
  } > "$a2dpilot_stream_tmp" || exit 1
  chmod 0700 "$a2dpilot_stream_tmp" || exit 1
  "$a2dpilot_stream_tmp" "$@"
  exit $?
fi

set -Eeuo pipefail

SCRIPT_PATH=$(readlink -f -- "${BASH_SOURCE[0]}")
INSTALLED_CLI=/usr/local/sbin/a2dpilot
CONFIG_FILE=/etc/a2dpilot.conf
STATE_DIR=/var/lib/a2dpilot
BACKUP_DIR=$STATE_DIR/backup
STATE_FILE=$STATE_DIR/state
SYSTEMD_UNIT=/etc/systemd/system/a2dpilot.service
WIREPLUMBER_CONF=/etc/wireplumber/wireplumber.conf.d/51-a2dpilot.conf
TRIGGER_CONF=/etc/triggerhappy/triggers.d/a2dpilot.conf
LOCK_FILE=/run/lock/a2dpilot/lock
MEDIA_LOCK_FILE=/run/a2dpilot/media.lock
MEDIA_STATE_DIR=/run/a2dpilot
# Debian's triggerhappy.service drops handler processes to this account.
MEDIA_RUNTIME_USER=nobody
RFKILL_SYSFS=/sys/class/rfkill
CONNECT_TIMEOUT=10
SCAN_TIMEOUT=15
VOLUME_STEP=5

PACKAGES=(
  bluez
  bluez-firmware
  pipewire
  pipewire-alsa
  pipewire-pulse
  wireplumber
  libspa-0.2-bluetooth
  rtkit
  triggerhappy
  curl
  rfkill
)

USER_UNITS=(
  # Stop activation paths before their services while restoring inactive units.
  pipewire.socket
  pipewire.service
  pipewire-pulse.socket
  pipewire-pulse.service
  wireplumber.service
)

USER_ENABLEMENT_UNITS=(
  # PipeWire services use Also= to enable their sockets, so restore each
  # service before its socket can re-establish the socket's exact state.
  pipewire.service
  pipewire.socket
  pipewire-pulse.service
  pipewire-pulse.socket
  wireplumber.service
)

SYSTEM_UNITS=(
  bluetooth.service
  # Restoration must activate the socket before its associated service.
  triggerhappy.socket
  triggerhappy.service
  a2dpilot.service
)

