usage() {
  cat <<'EOF'
Usage:
  sudo a2dpilot install [--user USER] [--non-interactive]
  sudo a2dpilot config [--check]
  sudo a2dpilot devices
  sudo a2dpilot pair [MAC | --all] [--agent CAPABILITY]
  sudo a2dpilot forget MAC [--yes]
  sudo a2dpilot status
  sudo a2dpilot uninstall [--keep-bonds | --remove-bonds] [--with-dependencies]

Internal integration commands:
  a2dpilot daemon
  a2dpilot player-control KEY_NAME

Configuration: /etc/a2dpilot.conf
EOF
}

die() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }
note() { printf '%s\n' "$*"; }
warn() { printf 'Warning: %s\n' "$*" >&2; }

require_root() {
  [[ ${EUID:-$(id -u)} -eq 0 ]] || die "Run this command with sudo."
}

has_tty() {
  [[ -t 1 || -t 2 ]] && [[ -r /dev/tty && -w /dev/tty ]]
}

tty_print() {
  # shellcheck disable=SC2059 # This wrapper intentionally accepts printf arguments.
  printf "$@" > /dev/tty
}

tty_read() {
  local variable=$1
  # shellcheck disable=SC2229 # Bash read accepts a variable name here.
  IFS= read -r "$variable" < /dev/tty
}

prepare_lock_directory() {
  local directory owner
  directory=$(dirname "$LOCK_FILE")
  validate_directory_chain "$directory"
  if [[ ! -e $directory ]]; then
    mkdir -m 0755 -- "$directory" 2>/dev/null || true
  fi
  [[ -d $directory && ! -L $directory ]] || die "Unsafe lock directory: $directory"
  owner=$(stat -c %u "$directory")
  [[ $owner == 0 ]] || die "Lock directory must be owned by root: $directory"
  chmod 0755 "$directory"
  [[ ! -e $LOCK_FILE || -f $LOCK_FILE && ! -L $LOCK_FILE ]] || \
    die "Unsafe lock file: $LOCK_FILE"
}

acquire_lock() {
  local timeout=${1:-} previous_umask
  prepare_lock_directory
  previous_umask=$(umask)
  umask 077
  if ! exec {LOCK_FD}> "$LOCK_FILE"; then
    umask "$previous_umask"
    return 1
  fi
  umask "$previous_umask"
  chmod 0600 "$LOCK_FILE"
  if [[ -n $timeout ]]; then
    if ! flock -w "$timeout" "$LOCK_FD"; then
      exec {LOCK_FD}>&-
      LOCK_FD=
      return 1
    fi
  else
    flock "$LOCK_FD"
  fi
}

release_lock() {
  if [[ -n ${LOCK_FD:-} ]]; then
    flock -u "$LOCK_FD" 2>/dev/null || true
    exec {LOCK_FD}>&-
    LOCK_FD=
  fi
}

acquire_media_lock() {
  local previous_umask media_group
  prepare_media_state_directory || return 1
  [[ ! -e $MEDIA_LOCK_FILE || -f $MEDIA_LOCK_FILE && ! -L $MEDIA_LOCK_FILE ]] || return 1
  previous_umask=$(umask)
  umask 077
  if ! exec {MEDIA_LOCK_FD}> "$MEDIA_LOCK_FILE"; then
    umask "$previous_umask"
    return 1
  fi
  umask "$previous_umask"
  if [[ ${EUID:-$(id -u)} -eq 0 ]]; then
    media_group=$(id -gn "$MEDIA_RUNTIME_USER") || return 1
    chown "$MEDIA_RUNTIME_USER:$media_group" "$MEDIA_LOCK_FILE" || return 1
  fi
  chmod 0600 "$MEDIA_LOCK_FILE"
  if ! flock -w 3 "$MEDIA_LOCK_FD"; then
    exec {MEDIA_LOCK_FD}>&-
    MEDIA_LOCK_FD=
    return 1
  fi
}

release_media_lock() {
  if [[ -n ${MEDIA_LOCK_FD:-} ]]; then
    flock -u "$MEDIA_LOCK_FD" 2>/dev/null || true
    exec {MEDIA_LOCK_FD}>&-
    MEDIA_LOCK_FD=
  fi
}

trim() {
  local value=$1
  value=${value#"${value%%[![:space:]]*}"}
  value=${value%"${value##*[![:space:]]}"}
  printf '%s' "$value"
}

valid_mac() {
  [[ $1 =~ ^([[:xdigit:]]{2}:){5}[[:xdigit:]]{2}$ ]]
}

normalize_mac() {
  printf '%s\n' "${1^^}"
}

valid_url_port() {
  local port=$1
  [[ $port =~ ^[0-9]{1,5}$ ]] || return 1
  (( 10#$port >= 1 && 10#$port <= 65535 ))
}

valid_ipv6_literal() {
  local address=$1 left right side group count=0
  local -a groups=()
  [[ $address == *:* && $address != *:::* ]] || return 1
  if [[ $address == *::* ]]; then
    left=${address%%::*}
    right=${address#*::}
    [[ $right != *::* ]] || return 1
    for side in "$left" "$right"; do
      [[ -n $side ]] || continue
      IFS=: read -r -a groups <<< "$side"
      for group in "${groups[@]}"; do
        [[ $group =~ ^[0-9A-Fa-f]{1,4}$ ]] || return 1
        count=$((count + 1))
      done
    done
    (( count < 8 ))
  else
    IFS=: read -r -a groups <<< "$address"
    (( ${#groups[@]} == 8 )) || return 1
    for group in "${groups[@]}"; do
      [[ $group =~ ^[0-9A-Fa-f]{1,4}$ ]] || return 1
    done
  fi
}

valid_http_authority() {
  local authority=$1 host port='' label octet ipv6
  local -a labels=()
  if [[ $authority =~ ^\[([0-9A-Fa-f:.]+)\](:([0-9]+))?$ ]]; then
    ipv6=${BASH_REMATCH[1]}
    valid_ipv6_literal "$ipv6" || return 1
    port=${BASH_REMATCH[3]:-}
  elif [[ $authority =~ ^([^:]+)(:([0-9]+))?$ ]]; then
    host=${BASH_REMATCH[1]}
    port=${BASH_REMATCH[3]:-}
    [[ ${#host} -le 253 && $host != .* && $host != *. && $host != *..* ]] || return 1
    IFS=. read -r -a labels <<< "$host"
    for label in "${labels[@]}"; do
      [[ ${#label} -le 63 && $label =~ ^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?$ ]] || return 1
    done
    if [[ $host =~ ^[0-9.]+$ ]]; then
      (( ${#labels[@]} == 4 )) || return 1
      for octet in "${labels[@]}"; do
        [[ $octet =~ ^[0-9]{1,3}$ ]] && (( 10#$octet <= 255 )) || return 1
      done
    fi
  else
    return 1
  fi
  [[ -z $port ]] || valid_url_port "$port"
}

valid_http_url() {
  local url=$1 authority
  [[ ! $url =~ [[:space:][:cntrl:]] ]] || return 1
  [[ $url =~ ^https?://([^/?#]+) ]] || return 1
  authority=${BASH_REMATCH[1]}
  valid_http_authority "$authority"
}

valid_url_path() {
  local path=$1 remaining allowed
  allowed="^[/A-Za-z0-9._~!\$&'()*+,;=:@%-]*$"
  [[ -z $path || $path == /* ]] || return 1
  [[ $path =~ $allowed ]] || return 1
  remaining=${path//%[[:xdigit:]][[:xdigit:]]/}
  [[ $remaining != *%* ]]
}

valid_base_url() {
  local url=$1 path
  [[ $url != *\?* && $url != *\#* && $url != *\{* && $url != *\}* ]] || return 1
  valid_http_url "$url" || return 1
  [[ $url =~ ^https?://[^/]+(.*)$ ]] || return 1
  path=${BASH_REMATCH[1]}
  valid_url_path "$path"
}

normalize_base_url() {
  local url=$1
  while [[ $url == */ ]]; do url=${url%/}; done
  printf '%s\n' "$url"
}

valid_relative_media_reference() {
  local reference=$1 path canonical segment
  local -a segments=()
  [[ -n $reference && $reference != //* && $reference != \?* && $reference != \#* ]] || return 1
  [[ ! $reference =~ ^[A-Za-z][A-Za-z0-9+.-]*: ]] || return 1
  path=${reference%%[?#]*}
  [[ -n $path ]] || return 1
  canonical=$path
  [[ $canonical == /* ]] || canonical=/$canonical
  valid_url_path "$canonical" || return 1
  IFS=/ read -r -a segments <<< "$canonical"
  for segment in "${segments[@]}"; do
    [[ $segment != . && $segment != .. ]] || return 1
  done
}

normalize_media_url_template() {
  local template=$1
  if [[ $template =~ ^https?:// || $template == /* ]]; then
    printf '%s\n' "$template"
  else
    printf '/%s\n' "$template"
  fi
}

valid_media_url_template() {
  local template=$1 base_url=$2 expanded normalized state_placeholders=0
  [[ ! $template =~ [[:space:][:cntrl:]] ]] || return 1
  [[ $template != *'{volume-up}'* ]] || state_placeholders=$((state_placeholders + 1))
  [[ $template != *'{volume-down}'* ]] || state_placeholders=$((state_placeholders + 1))
  [[ $template != *'{mute-toggle}'* ]] || state_placeholders=$((state_placeholders + 1))
  [[ $template != *'{shuffle-toggle}'* ]] || state_placeholders=$((state_placeholders + 1))
  [[ $template != *'{repeat-cycle}'* ]] || state_placeholders=$((state_placeholders + 1))
  (( state_placeholders <= 1 )) || return 1
  expanded=${template//\{command-id\}/0}
  expanded=${expanded//\{volume-up\}/100}
  expanded=${expanded//\{volume-down\}/0}
  expanded=${expanded//\{mute-toggle\}/0}
  expanded=${expanded//\{shuffle-toggle\}/1}
  expanded=${expanded//\{repeat-cycle\}/2}
  [[ $expanded != *\{* && $expanded != *\}* ]] || return 1
  if [[ $template =~ ^https?:// ]]; then
    valid_http_url "$expanded"
  else
    valid_relative_media_reference "$expanded" || return 1
    [[ -n $base_url ]] || return 1
    normalized=$(normalize_media_url_template "$expanded")
    valid_http_url "$base_url$normalized"
  fi
}

config_fail() {
  CONFIG_ERROR=$1
  return 1
}

parse_config() {
  local path=${1:-$CONFIG_FILE}
  local raw line key value lineno=0
  local audio_user='' controller='' interval='' media_controls='' base_url='' home
  local media_key media_url index
  local -a speakers=() media_keys=() media_urls=() media_lines=()
  local -A scalar_seen=() speaker_seen=() media_key_seen=()

  CONFIG_ERROR=
  [[ -f $path && ! -L $path ]] || {
    config_fail "Configuration is missing or unsafe: $path"
    return 1
  }

  while IFS= read -r raw || [[ -n $raw ]]; do
    lineno=$((lineno + 1))
    line=$(trim "$raw")
    [[ -z $line || $line == \#* ]] && continue
    [[ $line == *=* ]] || {
      config_fail "$path:$lineno: expected key = value"
      return 1
    }
    key=$(trim "${line%%=*}")
    value=$(trim "${line#*=}")
    [[ -n $key && -n $value ]] || {
      config_fail "$path:$lineno: key and value must not be empty"
      return 1
    }

    case $key in
      audio-user|controller|reconnect-interval|media-controls|base-url)
        [[ ! ${scalar_seen[$key]+present} ]] || {
          config_fail "$path:$lineno: duplicate setting: $key"
          return 1
        }
        scalar_seen[$key]=1
        case $key in
          audio-user) audio_user=$value ;;
          controller) controller=$value ;;
          reconnect-interval) interval=$value ;;
          media-controls) media_controls=$value ;;
          base-url) base_url=$value ;;
        esac
        ;;
      speaker)
        valid_mac "$value" || {
          config_fail "$path:$lineno: invalid speaker MAC address: $value"
          return 1
        }
        value=$(normalize_mac "$value")
        [[ ! ${speaker_seen[$value]+present} ]] || {
          config_fail "$path:$lineno: duplicate speaker: $value"
          return 1
        }
        speaker_seen[$value]=1
        speakers+=("$value")
        ;;
      media-key)
        media_key=${value%%[[:space:]]*}
        media_url=$(trim "${value#"$media_key"}")
        [[ $media_key != "$value" && -n $media_url ]] || {
          config_fail "$path:$lineno: media-key requires KEY_NAME followed by a URL"
          return 1
        }
        [[ $media_key =~ ^KEY_[A-Z0-9_]+$ ]] || {
          config_fail "$path:$lineno: invalid media key name: $media_key"
          return 1
        }
        [[ ! ${media_key_seen[$media_key]+present} ]] || {
          config_fail "$path:$lineno: duplicate media key: $media_key"
          return 1
        }
        media_key_seen[$media_key]=1
        media_keys+=("$media_key")
        media_urls+=("$media_url")
        media_lines+=("$lineno")
        ;;
      *)
        config_fail "$path:$lineno: unknown setting: $key"
        return 1
        ;;
    esac
  done < "$path"

  for key in audio-user controller reconnect-interval media-controls; do
    [[ ${scalar_seen[$key]+present} ]] || {
      config_fail "$path: missing required setting: $key"
      return 1
    }
  done

  id "$audio_user" >/dev/null 2>&1 || {
    config_fail "$path: audio user does not exist: $audio_user"
    return 1
  }
  home=$(user_home "$audio_user")
  [[ -n $home && -d $home ]] || {
    config_fail "$path: audio user has no usable home directory: $audio_user"
    return 1
  }
  if [[ $controller != auto ]]; then
    valid_mac "$controller" || {
      config_fail "$path: controller must be 'auto' or a MAC address"
      return 1
    }
    controller=$(normalize_mac "$controller")
  fi
  [[ $interval =~ ^[1-9][0-9]*$ ]] || {
    config_fail "$path: reconnect-interval must be a positive integer"
    return 1
  }
  case $media_controls in
    auto|required|off) ;;
    *)
      config_fail "$path: media-controls must be auto, required, or off"
      return 1
      ;;
  esac
  if [[ ${scalar_seen[base-url]+present} ]]; then
    valid_base_url "$base_url" || {
      config_fail "$path: base-url must be an HTTP or HTTPS URL without a query or fragment"
      return 1
    }
    base_url=$(normalize_base_url "$base_url")
  fi
  for index in "${!media_keys[@]}"; do
    if [[ ! ${media_urls[$index]} =~ ^https?:// && -z $base_url ]]; then
      config_fail "$path:${media_lines[$index]}: relative media-key URL requires base-url"
      return 1
    fi
    if [[ ${media_urls[$index]} == *'{volume-up}'* ||
          ${media_urls[$index]} == *'{volume-down}'* ||
          ${media_urls[$index]} == *'{mute-toggle}'* ||
          ${media_urls[$index]} == *'{shuffle-toggle}'* ||
          ${media_urls[$index]} == *'{repeat-cycle}'* ]] && [[ -z $base_url ]]; then
      config_fail "$path:${media_lines[$index]}: stateful media-key placeholder requires base-url"
      return 1
    fi
    valid_media_url_template "${media_urls[$index]}" "$base_url" || {
      config_fail "$path:${media_lines[$index]}: invalid media-key URL or placeholder"
      return 1
    }
    media_urls[index]=$(normalize_media_url_template "${media_urls[$index]}")
  done

  CFG_AUDIO_USER=$audio_user
  CFG_CONTROLLER=$controller
  CFG_RECONNECT_INTERVAL=$interval
  CFG_MEDIA_CONTROLS=$media_controls
  CFG_BASE_URL=$base_url
  CFG_SPEAKERS=("${speakers[@]}")
  CFG_MEDIA_KEYS=("${media_keys[@]}")
  CFG_MEDIA_URLS=("${media_urls[@]}")
}

write_default_config() {
  local path=$1 audio_user=$2
  {
    printf 'audio-user = %s\n' "$audio_user"
    printf 'controller = auto\n'
    printf 'reconnect-interval = 5\n'
    printf 'media-controls = auto\n'
    printf 'base-url = http://127.0.0.1:32500\n\n'
    printf 'media-key = KEY_PLAYPAUSE player/playback/playPause?type=music&commandID={command-id}\n'
    printf 'media-key = KEY_PLAY player/playback/play?type=music&commandID={command-id}\n'
    printf 'media-key = KEY_PLAYCD player/playback/play?type=music&commandID={command-id}\n'
    printf 'media-key = KEY_PAUSE player/playback/pause?type=music&commandID={command-id}\n'
