#!/usr/bin/env bash

# When Bash reads this program from stdin, preserve the unread application body
# in a real file and re-execute it. This makes curl | sudo bash installs able to
# copy the complete application to its permanent location.
if [[ -z ${BASH_SOURCE[0]:-} ]]; then
  a2dpilot_stream_tmp=$(mktemp "/tmp/a2dpilot-stream.XXXXXX") || exit 1
  trap 'rm -f -- "$a2dpilot_stream_tmp"' EXIT
  {
    printf '%s\n' '#!/usr/bin/env bash'
    dd status=none
  } > "$a2dpilot_stream_tmp" || exit 1
  chmod 0700 "$a2dpilot_stream_tmp" || exit 1
  "$a2dpilot_stream_tmp" "$@"
  exit $?
fi

