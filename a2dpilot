validate_directory_chain() {
  local directory=$1 current=/ component
  local -a components=()
  [[ $directory == /* ]] || die "Directory path must be absolute: $directory"
  IFS=/ read -r -a components <<< "${directory#/}"
  for component in "${components[@]}"; do
    [[ -n $component ]] || continue
    current=${current%/}/$component
    [[ ! -L $current ]] || die "Refusing to traverse symlinked directory: $current"
    [[ ! -e $current || -d $current ]] || die "Path component is not a directory: $current"
  done
}

valid_update_ref() {
  local ref=$1 component
  local -a components=()
  [[ -n $ref && $ref =~ ^[A-Za-z0-9_.+@/-]+$ ]] || return 1
  [[ $ref != @ && $ref != /* && $ref != */ && $ref != *. && \
     $ref != *//* && $ref != *..* && $ref != *@\{* ]] || return 1
  IFS=/ read -r -a components <<< "$ref"
  for component in "${components[@]}"; do
    [[ -n $component && $component != .* && $component != *.lock ]] || return 1
  done
}

update_source_url() {
  local selector=$1 ref=$2
  case $selector in
    branch) printf '%s/refs/heads/%s/a2dpilot\n' "$UPDATE_BASE_URL" "$ref" ;;
    tag) printf '%s/refs/tags/%s/a2dpilot\n' "$UPDATE_BASE_URL" "$ref" ;;
    sha) printf '%s/%s/a2dpilot\n' "$UPDATE_BASE_URL" "$ref" ;;
    *) return 1 ;;
  esac
}

update_candidate_has_bash_shebang() {
  local shebang
  IFS= read -r shebang < "$1" || return 1
  [[ $shebang == '#!/usr/bin/env bash' ]]
}

valid_a2dpilot_version() {
  [[ $1 =~ ^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]]
}

read_a2dpilot_version() {
  local path=$1 target=$2 line value='' declarations=0
  while IFS= read -r line || [[ -n $line ]]; do
    [[ $line == A2DPILOT_VERSION=* ]] || continue
    declarations=$((declarations + 1))
    value=${line#A2DPILOT_VERSION=}
    valid_a2dpilot_version "$value" || return 1
  done < "$path"
  (( declarations == 1 )) || return 1
  printf -v "$target" '%s' "$value"
}

a2dpilot_version_is_older() {
  local candidate=$1 current=$2 candidate_part current_part index digit_index
  local -a candidate_parts=() current_parts=()
  valid_a2dpilot_version "$candidate" && valid_a2dpilot_version "$current" || return 2
  IFS=. read -r -a candidate_parts <<< "$candidate"
  IFS=. read -r -a current_parts <<< "$current"
  for index in 0 1 2; do
    candidate_part=${candidate_parts[$index]}
    current_part=${current_parts[$index]}
    if (( ${#candidate_part} < ${#current_part} )); then
      return 0
    elif (( ${#candidate_part} > ${#current_part} )); then
      return 1
    fi
    for (( digit_index = 0; digit_index < ${#candidate_part}; digit_index++ )); do
      if (( ${candidate_part:digit_index:1} < ${current_part:digit_index:1} )); then
        return 0
      elif (( ${candidate_part:digit_index:1} > ${current_part:digit_index:1} )); then
        return 1
      fi
    done
  done
  return 1
}

validate_managed_paths() {
  local path
  local -A seen=()
  for path in "$@"; do
    [[ $path == /* && $path != *$'\n'* ]] || die "Invalid managed path: $path"
    [[ ! ${seen[$path]+present} ]] || die "Managed paths must be unique: $path"
    seen[$path]=1
    validate_directory_chain "$(dirname "$path")"
  done
}

allowed_managed_path() {
  case $1 in
    "$INSTALLED_CLI"|"$CONFIG_FILE"|"$SYSTEMD_UNIT"|"$WIREPLUMBER_CONF"|"$TRIGGER_CONF") return 0 ;;
    *) return 1 ;;
  esac
}

backup_file() {
  local path=$1
  allowed_managed_path "$path" || die "Refusing to back up unmanaged path: $path"
  [[ ! -d $path || -L $path ]] || die "Refusing to replace a directory: $path"
  if [[ -e $path || -L $path ]]; then
    install -d -m 0700 "$BACKUP_DIR$(dirname "$path")"
    cp -a -- "$path" "$BACKUP_DIR$path"
    printf '%s\n' "$path" >> "$STATE_DIR/replaced-files"
  else
    printf '%s\n' "$path" >> "$STATE_DIR/created-files"
  fi
}

prepare_file_target() {
  local path=$1
  [[ ! -d $path || -L $path ]] || die "Refusing to replace a directory: $path"
  rm -f -- "$path"
}

atomic_install_file() {
  local source=$1 destination=$2 mode=${3:-0644} directory temp
  directory=$(dirname "$destination")
  validate_directory_chain "$directory"
  [[ ! -d $destination || -L $destination ]] || return 1
  temp=$(mktemp "$directory/.a2dpilot.XXXXXX") || return 1
  if ! install -o root -g root -m "$mode" "$source" "$temp" || ! mv -f -- "$temp" "$destination"; then
    rm -f -- "$temp"
    return 1
  fi
}

read_install_phase() {
  [[ -f $STATE_FILE && ! -L $STATE_FILE ]] || return 1
  (
    # SC1090: STATE_FILE is generated by A2DPilot and stored in its root-only
    # state directory; the variable path also supports isolated test fixtures.
    # shellcheck disable=SC1090
    source "$STATE_FILE"
    printf '%s\n' "${INSTALL_PHASE:-}"
  )
}

validate_update_target() {
  local owner
  ( validate_directory_chain "$(dirname "$INSTALLED_CLI")" ) || return 1
  [[ -f $INSTALLED_CLI && ! -L $INSTALLED_CLI ]] || {
    warn "Installed executable is missing or unsafe: $INSTALLED_CLI"
    return 1
  }
  owner=$(stat -c %u -- "$INSTALLED_CLI") || return 1
  [[ $owner == 0 ]] || {
    warn "Installed executable must be owned by root: $INSTALLED_CLI"
    return 1
  }
}

update_target_metadata_current() {
  [[ $(stat -c %u -- "$INSTALLED_CLI") == 0 &&
     $(stat -c %g -- "$INSTALLED_CLI") == 0 &&
     $(stat -c %a -- "$INSTALLED_CLI") == 755 ]]
}

user_home() {
  getent passwd "$1" | cut -d: -f6
}

as_user_systemctl() {
  local user=$1 uid runtime home
  shift
  uid=$(id -u "$user")
  runtime=/run/user/$uid
  home=$(user_home "$user")
  runuser -u "$user" -- env HOME="$home" XDG_RUNTIME_DIR="$runtime" \
    DBUS_SESSION_BUS_ADDRESS="unix:path=$runtime/bus" systemctl --user "$@"
}

bounded_user_systemctl() {
  local user=$1 seconds=$2 uid runtime home
  shift 2
  [[ $seconds =~ ^[1-9][0-9]*$ ]] || return 1
  uid=$(id -u "$user")
  runtime=/run/user/$uid
  home=$(user_home "$user")
  runuser -u "$user" -- env HOME="$home" XDG_RUNTIME_DIR="$runtime" \
    DBUS_SESSION_BUS_ADDRESS="unix:path=$runtime/bus" \
    timeout --signal=TERM --kill-after=1 "$seconds" systemctl --user "$@"
}

bounded_user_pipewire_command() {
  local user=$1 seconds=$2 command=$3 uid runtime home
  shift 3
  [[ $seconds =~ ^[1-9][0-9]*$ ]] || return 1
  case $command in
    pw-cli|pw-metadata|wpctl) ;;
    *) return 1 ;;
  esac
  uid=$(id -u "$user")
  runtime=/run/user/$uid
  home=$(user_home "$user")
  runuser -u "$user" -- env HOME="$home" XDG_RUNTIME_DIR="$runtime" \
    DBUS_SESSION_BUS_ADDRESS="unix:path=$runtime/bus" \
    timeout --signal=TERM --kill-after=1 "$seconds" "$command" "$@"
}

bounded_user_pw_cli() {
  local user=$1 seconds=$2
  shift 2
  bounded_user_pipewire_command "$user" "$seconds" pw-cli "$@"
}

bounded_user_wpctl() {
  local user=$1 seconds=$2
  shift 2
  bounded_user_pipewire_command "$user" "$seconds" wpctl "$@"
}

bounded_user_pw_metadata() {
  local user=$1 seconds=$2
  shift 2
  bounded_user_pipewire_command "$user" "$seconds" pw-metadata "$@"
}

system_unit_enabled_state() {
  systemctl is-enabled "$1" 2>/dev/null || true
}

system_unit_active_bit() {
  [[ $(systemctl is-active "$1" 2>/dev/null || true) == active ]] && printf '1\n' || printf '0\n'
}

checked_system_unit_active_bit() {
  local state
  state=$(systemctl is-active "$1" 2>/dev/null) || true
  case $state in
    active|reloading) printf '1\n' ;;
    inactive|failed) printf '0\n' ;;
    *) return 1 ;;
  esac
}

user_unit_enabled_state() {
  local user=$1 unit=$2 home
  home=$(user_home "$user")
  runuser -u "$user" -- env HOME="$home" systemctl --user --root=/ is-enabled "$unit" 2>/dev/null || true
}

user_unit_active_bit() {
  local user=$1 unit=$2 uid
  uid=$(id -u "$user")
  if [[ -S /run/user/$uid/systemd/private ]] && \
    [[ $(as_user_systemctl "$user" is-active "$unit" 2>/dev/null || true) == active ]]; then
    printf '1\n'
  else
    printf '0\n'
  fi
}

validate_enabled_state() {
  case $1 in
    enabled|enabled-runtime|disabled|not-found|masked|masked-runtime|static|indirect|generated|transient|alias) return 0 ;;
    *) return 1 ;;
  esac
}

record_system_service_states() {
  local unit enabled active
  : > "$STATE_DIR/system-service-states"
  for unit in "${SYSTEM_UNITS[@]}"; do
    enabled=$(system_unit_enabled_state "$unit")
    [[ -n $enabled ]] || enabled=not-found
    validate_enabled_state "$enabled" || die "Unsupported enablement state '$enabled' for $unit."
    active=$(system_unit_active_bit "$unit")
    printf '%s %s %s\n' "$unit" "$enabled" "$active" >> "$STATE_DIR/system-service-states"
  done
}

user_state_dir() {
  printf '%s/users/%s\n' "$STATE_DIR" "$(id -u "$1")"
}

record_user_state() {
  local user=$1 directory unit enabled active linger
  directory=$(user_state_dir "$user")
  [[ ! -e $directory || -d $directory && ! -L $directory ]] || die "Unsafe user state directory: $directory"
  [[ ! -f $directory/recorded ]] || return 0
  install -d -m 0700 "$directory"
  printf '%s\n' "$user" > "$directory/user"
  linger=$(loginctl show-user "$user" -p Linger --value 2>/dev/null || true)
  [[ $linger == yes ]] || linger=no
  printf '%s\n' "$linger" > "$directory/linger"
  : > "$directory/service-states"
  for unit in "${USER_UNITS[@]}"; do
    enabled=$(user_unit_enabled_state "$user" "$unit")
    [[ -n $enabled ]] || enabled=not-found
    validate_enabled_state "$enabled" || die "Unsupported enablement state '$enabled' for $user unit $unit."
    active=$(user_unit_active_bit "$user" "$unit")
    printf '%s %s %s\n' "$unit" "$enabled" "$active" >> "$directory/service-states"
  done
  : > "$directory/recorded"
}

scoped_systemctl() {
  local scope=$1 user=$2
  shift 2
  if [[ $scope == system ]]; then
    systemctl "$@"
  else
    as_user_systemctl "$user" "$@"
  fi
}

unmask_units_all_scopes() {
  local scope=$1 user=$2
  shift 2
  scoped_systemctl "$scope" "$user" unmask "$@" || return 1
  scoped_systemctl "$scope" "$user" unmask --runtime "$@"
}

set_unit_enabled_state() {
  local scope=$1 user=$2 unit=$3 state=$4
  local -a command=()

  # Disabled and masked are distinct systemd states. Always clear the state
  # A2DPilot needed while installed before recreating the recorded state.
  unmask_units_all_scopes "$scope" "$user" "$unit" || return 1

  case $state in
    enabled) command=(enable "$unit") ;;
    enabled-runtime) command=(enable --runtime "$unit") ;;
    disabled|not-found) command=(disable "$unit") ;;
    masked) command=(mask "$unit") ;;
    masked-runtime) command=(mask --runtime "$unit") ;;
    static|indirect|generated|transient|alias) return 0 ;;
    *) return 1 ;;
  esac
  scoped_systemctl "$scope" "$user" "${command[@]}"
}

restore_unit_state_and_activity() {
  local scope=$1 user=$2 unit=$3 state=$4 active=$5 action=$6
  local -a mask_command=(mask "$unit")
  # Masking does not stop a running unit, but it does prevent a later start.
  # Recreate the recorded active-and-masked state in that required order.
  if [[ $active == 1 && ( $state == masked || $state == masked-runtime ) ]]; then
    [[ $state != masked-runtime ]] || mask_command=(mask --runtime "$unit")
    unmask_units_all_scopes "$scope" "$user" "$unit" || return 1
    scoped_systemctl "$scope" "$user" "$action" "$unit" || return 1
    scoped_systemctl "$scope" "$user" "${mask_command[@]}"
  else
    set_unit_enabled_state "$scope" "$user" "$unit" "$state" || return 1
    scoped_systemctl "$scope" "$user" "$action" "$unit"
  fi
}

restore_user_state() {
  local user=$1 directory unit enabled active uid linger load_state action
  local -A enabled_states=() restorable=()
  directory=$(user_state_dir "$user")
  [[ -f $directory/recorded ]] || return 0
  uid=$(id -u "$user")
  loginctl enable-linger "$user" || return 1
  systemctl start "user@$uid.service" || return 1
  while read -r unit enabled active; do
    [[ -n $unit ]] || continue
    load_state=$(as_user_systemctl "$user" show "$unit" -p LoadState --value 2>/dev/null || true)
    if [[ $load_state == not-found && $enabled == not-found && $active == 0 ]]; then
      continue
    fi
    [[ $load_state != not-found ]] || return 1
    enabled_states[$unit]=$enabled
    restorable[$unit]=1
    action=stop
    [[ $active == 1 ]] && action=start
    [[ $unit == wireplumber.service && $active == 1 ]] && action=restart
    # Restore activity in snapshot order so sockets are stopped before the
    # services they can activate. Enablement is restored separately below.
    unmask_units_all_scopes user "$user" "$unit" || return 1
    scoped_systemctl user "$user" "$action" "$unit" || return 1
  done < "$directory/service-states"
  for unit in "${USER_ENABLEMENT_UNITS[@]}"; do
    [[ ${restorable[$unit]+present} ]] || continue
    set_unit_enabled_state user "$user" "$unit" "${enabled_states[$unit]}" || return 1
  done
  linger=$(< "$directory/linger")
  if [[ $linger != yes ]]; then
    loginctl disable-linger "$user" || return 1
  fi
}

ensure_audio_user() {
  local user=$1 uid home
  id "$user" >/dev/null 2>&1 || return 1
  home=$(user_home "$user")
  [[ -n $home && -d $home ]] || return 1
  record_user_state "$user"
  uid=$(id -u "$user")
  loginctl enable-linger "$user" || return 1
  systemctl start "user@$uid.service" || return 1
  unmask_units_all_scopes user "$user" "${USER_UNITS[@]}" || return 1
  as_user_systemctl "$user" enable --now pipewire.service pipewire-pulse.service wireplumber.service || return 1
  as_user_systemctl "$user" restart wireplumber.service || return 1
}

reconcile_audio_user() {
  local new_user=$1 old_user=
  [[ -d $STATE_DIR ]] || return 0
  [[ -f $STATE_DIR/runtime-user ]] && old_user=$(< "$STATE_DIR/runtime-user")
  [[ $old_user == "$new_user" ]] && return 0
  if [[ -n $old_user && $old_user != "$new_user" ]] &&
     ! clear_recorded_default_sink "$old_user"; then
    warn "Could not clear A2DPilot's recorded PipeWire default for $old_user."
  fi
  ensure_audio_user "$new_user" || return 1
  if [[ -n $old_user && $old_user != "$new_user" ]] && id "$old_user" >/dev/null 2>&1; then
    restore_user_state "$old_user" || return 1
  fi
  printf '%s\n' "$new_user" > "$STATE_DIR/runtime-user"
}

restore_all_user_states() {
  local directory user failed=0
  [[ -d $STATE_DIR/users ]] || return 0
  for directory in "$STATE_DIR"/users/*; do
    [[ -d $directory && -f $directory/user ]] || continue
    user=$(< "$directory/user")
    if id "$user" >/dev/null 2>&1; then
      restore_user_state "$user" || failed=1
    else
      warn "Cannot restore state for missing user $user."
      failed=1
    fi
  done
  (( failed == 0 ))
}

restore_system_service_states() {
  local unit enabled active load_state action
  [[ -f $STATE_DIR/system-service-states ]] || return 0
  while read -r unit enabled active; do
    [[ -n $unit ]] || continue
    load_state=$(systemctl show "$unit" -p LoadState --value 2>/dev/null || true)
    if [[ $load_state == not-found && $enabled == not-found && $active == 0 ]]; then
      continue
    fi
    [[ $load_state != not-found ]] || return 1
    if [[ $unit == triggerhappy.socket && $active == 1 ]]; then
      # A2DPilot runs Triggerhappy directly; release its socket path before
      # restoring the original socket-activated service state.
      systemctl stop triggerhappy.service || return 1
    fi
    action=stop
    [[ $active == 1 ]] && action=start
    case $unit:$active in
      triggerhappy.service:1) action=restart ;;
    esac
    restore_unit_state_and_activity system '' "$unit" "$enabled" "$active" "$action" || return 1
  done < "$STATE_DIR/system-service-states"
}

record_rfkill_state() {
  local path name type soft
  : > "$STATE_DIR/rfkill-state"
  for path in "$RFKILL_SYSFS"/rfkill*; do
    [[ -f $path/type && -f $path/name && -f $path/soft ]] || continue
    type=$(< "$path/type")
    [[ $type == bluetooth ]] || continue
    name=$(< "$path/name")
    soft=$(< "$path/soft")
    printf '%s\t%s\n' "$soft" "$name" >> "$STATE_DIR/rfkill-state"
  done
}

restore_rfkill_state() {
  local original_soft original_name path name type id
  [[ -f $STATE_DIR/rfkill-state ]] || return 0
  while IFS=$'\t' read -r original_soft original_name; do
    [[ -n $original_name ]] || continue
    for path in "$RFKILL_SYSFS"/rfkill*; do
      [[ -f $path/type && -f $path/name ]] || continue
      type=$(< "$path/type")
      name=$(< "$path/name")
      [[ $type == bluetooth && $name == "$original_name" ]] || continue
      id=${path##*rfkill}
      if [[ $original_soft == 1 ]]; then
        rfkill block "$id" || warn "Could not restore rfkill block for $original_name."
      else
        rfkill unblock "$id" || warn "Could not restore rfkill state for $original_name."
      fi
    done
  done < "$STATE_DIR/rfkill-state"
}

record_controller_state() {
  local line mac powered
  : > "$STATE_DIR/controller-state"
  command -v bluetoothctl >/dev/null 2>&1 || return 0
  while IFS= read -r line; do
    [[ $line =~ ^Controller[[:space:]]+(([[:xdigit:]]{2}:){5}[[:xdigit:]]{2}) ]] || continue
    mac=${BASH_REMATCH[1]^^}
    powered=$(bluetoothctl show "$mac" 2>/dev/null | awk '/^[[:space:]]*Powered:/ { print $2; exit }')
    case $powered in yes|no) printf '%s %s\n' "$mac" "$powered" >> "$STATE_DIR/controller-state" ;; esac
  done < <(bluetoothctl list 2>/dev/null || true)
}

restore_controller_state() {
  local mac powered
  [[ -f $STATE_DIR/controller-state ]] || return 0
  while read -r mac powered; do
    [[ -n $mac ]] || continue
    if bluetoothctl list 2>/dev/null | grep -Fqi "Controller $mac "; then
      if ! controller_batch "$mac" 5 "power $powered" >/dev/null 2>&1 ||
         [[ $(controller_power_state "$mac" 2>/dev/null || true) != "$powered" ]]; then
        warn "Could not restore controller $mac power state to $powered."
      fi
    fi
  done < "$STATE_DIR/controller-state"
}

render_state_file() {
  local path=$1 phase=$2
  (
    umask 077
    printf 'INSTALL_PHASE=%q\n' "$phase" > "$path"
  )
}

write_state_file() {
  local phase=$1 temp=$STATE_FILE.tmp
  render_state_file "$temp" "$phase"
  mv -f -- "$temp" "$STATE_FILE"
}

write_systemd_unit() {
  local path=$1 media_group
  media_group=$(id -gn "$MEDIA_RUNTIME_USER") || return 1
  cat > "$path" <<EOF
[Unit]
Description=A2DPilot Bluetooth audio connection manager
After=bluetooth.service
Wants=bluetooth.service
Before=triggerhappy.service

[Service]
Type=simple
RuntimeDirectory=a2dpilot
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=restart
ExecStartPre=/usr/bin/install -d -o $MEDIA_RUNTIME_USER -g $media_group -m 0700 $MEDIA_STATE_DIR
ExecStart=$INSTALLED_CLI daemon
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF
  chmod 0644 "$path"
}

write_wireplumber_config() {
  local path=$1
  cat > "$path" <<'EOF'
wireplumber.profiles = {
  main = {
    monitor.bluez.seat-monitoring = disabled
  }
}
EOF
  if [[ $CFG_ONBOARD_ANALOG == disabled || $CFG_ONBOARD_HDMI == disabled ]]; then
    printf '\nmonitor.alsa.rules = [\n' >> "$path"
    if [[ $CFG_ONBOARD_ANALOG == disabled ]]; then
      cat >> "$path" <<'EOF'
  {
    matches = [
      {
        device.form-factor = "internal"
        api.alsa.card.name = "~bcm2835.*[Hh]eadphones.*"
      }
    ]
    actions = {
      update-props = {
        device.disabled = true
      }
    }
  }
EOF
    fi
    if [[ $CFG_ONBOARD_HDMI == disabled ]]; then
      cat >> "$path" <<'EOF'
  {
    matches = [
      {
        device.form-factor = "internal"
        api.alsa.card.name = "~vc4-hdmi.*"
      }
    ]
    actions = {
      update-props = {
        device.disabled = true
      }
    }
  }
EOF
    fi
    printf ']\n' >> "$path"
  fi
  chmod 0644 "$path"
}

apply_wireplumber_config() {
  local directory temp
  directory=$(dirname "$WIREPLUMBER_CONF")
  ( validate_directory_chain "$directory" ) || return 1
  install -d -m 0755 "$directory" || return 1
  ( validate_directory_chain "$directory" ) || return 1
  temp=$(mktemp "$directory/.a2dpilot-wireplumber.XXXXXX") || return 1
  if ! write_wireplumber_config "$temp"; then
    rm -f -- "$temp"
    return 1
  fi
  if [[ -f $WIREPLUMBER_CONF && ! -L $WIREPLUMBER_CONF ]] && \
     cmp -s "$temp" "$WIREPLUMBER_CONF"; then
    rm -f -- "$temp"
    return 0
  fi
  [[ ! -L $WIREPLUMBER_CONF && ( ! -e $WIREPLUMBER_CONF || -f $WIREPLUMBER_CONF ) ]] || {
    rm -f -- "$temp"
    return 1
  }
  if ! ( validate_directory_chain "$directory" ) ||
     ! mv -f -- "$temp" "$WIREPLUMBER_CONF"; then
    rm -f -- "$temp"
    return 1
  fi
  as_user_systemctl "$CFG_AUDIO_USER" restart wireplumber.service
}

write_trigger_config() {
  local path=$1 mode=$2 index
  if [[ $mode == off ]]; then
    printf '# Managed by A2DPilot; media controls are disabled.\n' > "$path"
  elif (( ${#CFG_MEDIA_KEYS[@]} == 0 )); then
    printf '# Managed by A2DPilot; no media-key mappings are configured.\n' > "$path"
  else
    : > "$path"
    for index in "${!CFG_MEDIA_KEYS[@]}"; do
      printf '%s\t%s\t%s\n' "${CFG_MEDIA_KEYS[$index]}" 1 \
        "$INSTALLED_CLI player-control ${CFG_MEDIA_KEYS[$index]}" >> "$path"
    done
  fi
  chmod 0644 "$path"
}

apply_trigger_config() {
  local mode=$1 directory temp
  directory=$(dirname "$TRIGGER_CONF")
  validate_directory_chain "$directory"
  install -d -m 0755 "$directory"
  temp=$(mktemp "$directory/.a2dpilot-trigger.XXXXXX") || return 1
  write_trigger_config "$temp" "$mode"
  if [[ -f $TRIGGER_CONF ]] && cmp -s "$temp" "$TRIGGER_CONF"; then
    rm -f -- "$temp"
    return 0
  fi
  mv -f -- "$temp" "$TRIGGER_CONF" || return 1
  systemctl try-restart triggerhappy.service || return 1
}

reconcile_runtime_configuration() {
  reconcile_audio_user "$CFG_AUDIO_USER" || return 1
  apply_wireplumber_config || return 1
  apply_trigger_config "$CFG_MEDIA_CONTROLS" || return 1
}

apply_locked_config_candidate() {
  local candidate=$1 old_copy=$2 success_message=$3
  local old_user=$CFG_AUDIO_USER old_mode=$CFG_MEDIA_CONTROLS
  local old_analog=$CFG_ONBOARD_ANALOG old_hdmi=$CFG_ONBOARD_HDMI new_user error
  if ! parse_config "$candidate"; then
    error=$CONFIG_ERROR
    rm -f -- "$old_copy" "$candidate"
    release_lock
    die "$error"
  fi
  new_user=$CFG_AUDIO_USER
  if ! atomic_install_file "$candidate" "$CONFIG_FILE" 0644; then
    rm -f -- "$old_copy" "$candidate"
    release_lock
    die "Could not install the configuration candidate."
  fi
  rm -f -- "$candidate"

  if reconcile_runtime_configuration; then
    release_lock
    if systemctl restart a2dpilot.service; then
      rm -f -- "$old_copy"
      note "$success_message"
      if [[ $old_user != "$CFG_AUDIO_USER" || $old_mode != "$CFG_MEDIA_CONTROLS" ||
            $old_analog != "$CFG_ONBOARD_ANALOG" || $old_hdmi != "$CFG_ONBOARD_HDMI" ]]; then
        note "Applied audio-user, media-control, or onboard-audio integration changes."
      fi
      return 0
    fi
    acquire_lock
  fi

  warn "Could not apply the configuration; restoring the previous version."
  atomic_install_file "$old_copy" "$CONFIG_FILE" 0644 || \
    die "Configuration rollback failed; previous copy remains at $old_copy"
  parse_config "$CONFIG_FILE" || die "$CONFIG_ERROR"
  reconcile_runtime_configuration || warn "Could not fully reapply the previous runtime configuration."
  if [[ $old_user != "$new_user" ]]; then
    restore_user_state "$new_user" || true
  fi
  rm -f -- "$old_copy"
  release_lock
  systemctl restart a2dpilot.service || warn "Could not restart A2DPilot with the restored configuration."
  die "Configuration application failed; the previous configuration was restored."
}

run_editor() {
  local path=$1 editor_user=$2 editor_spec
  local -a editor_command=()
  editor_spec=${SUDO_EDITOR:-${VISUAL:-${EDITOR:-editor}}}
  read -r -a editor_command <<< "$editor_spec"
  [[ ${#editor_command[@]} -gt 0 ]] || return 1
  if [[ $editor_user == root ]]; then
    "${editor_command[@]}" "$path"
  else
    runuser -u "$editor_user" -- "${editor_command[@]}" "$path"
  fi
}

config_action() {
  local check=0
  while [[ $# -gt 0 ]]; do
    case $1 in
      --check) check=1; shift ;;
      *) die "Unknown config option: $1" ;;
    esac
  done
  parse_config "$CONFIG_FILE" || die "$CONFIG_ERROR"
  if (( check )); then
    note "Configuration is valid: $CONFIG_FILE"
    return 0
  fi

  require_root
  [[ -f $STATE_FILE ]] || die "A2DPilot is not installed."
  acquire_lock
  local editor_user=${SUDO_USER:-root} editor_group edit_dir edit_tmp old_tmp candidate_tmp=''
  install -d -m 0755 "$(dirname "$LOCK_FILE")"
  edit_dir=$(mktemp -d "$(dirname "$LOCK_FILE")/.a2dpilot-edit.XXXXXX")
  edit_tmp=$edit_dir/a2dpilot.conf
  old_tmp=$(mktemp "$STATE_DIR/.a2dpilot-config-old.XXXXXX")
  cp -a -- "$CONFIG_FILE" "$old_tmp"
  cp -- "$CONFIG_FILE" "$edit_tmp"
  chmod 0600 "$edit_tmp"
  if [[ $editor_user != root ]]; then
    id "$editor_user" >/dev/null 2>&1 || die "Editor user does not exist: $editor_user"
    editor_group=$(id -gn "$editor_user")
    chown "$editor_user:$editor_group" "$edit_dir" "$edit_tmp"
    chmod 0700 "$edit_dir"
  fi

  if ! run_editor "$edit_tmp" "$editor_user"; then
    rm -rf -- "$edit_dir"
    rm -f -- "$old_tmp"
    release_lock
    die "Editor exited unsuccessfully; configuration was not changed."
  fi
  # Reclaim the workspace, then copy the edited inode into root-only state.
  # Ownership changes do not revoke an editor child's already-open descriptor;
  # validating and installing the new snapshot keeps those writes out of the
  # live configuration.
  chown root:root "$edit_dir"
  chmod 0700 "$edit_dir"
  if [[ ! -f $edit_tmp || -L $edit_tmp ]]; then
    rm -rf -- "$edit_dir"
    rm -f -- "$old_tmp"
    release_lock
    die "The editor produced an unsafe configuration candidate."
  fi
  chown root:root "$edit_tmp"
  chmod 0600 "$edit_tmp"
  candidate_tmp=$(mktemp "$STATE_DIR/.a2dpilot-config-new.XXXXXX") || {
    rm -rf -- "$edit_dir"
    rm -f -- "$old_tmp"
    release_lock
    die "Could not create a protected configuration snapshot."
  }
  if ! cp -- "$edit_tmp" "$candidate_tmp"; then
    rm -rf -- "$edit_dir"
    rm -f -- "$old_tmp" "$candidate_tmp"
    release_lock
    die "Could not snapshot the edited configuration."
  fi
  chmod 0600 "$candidate_tmp"
  rm -rf -- "$edit_dir"
  apply_locked_config_candidate "$candidate_tmp" "$old_tmp" "Configuration updated and applied."
}

hard_blocked() {
  local path type hard found=0
  for path in "$RFKILL_SYSFS"/rfkill*; do
    [[ -f $path/type && -f $path/hard ]] || continue
    type=$(< "$path/type")
    hard=$(< "$path/hard")
    [[ $type == bluetooth ]] || continue
    found=1
    [[ $hard == 1 ]] || return 1
  done
  (( found == 1 ))
}

controller_exists() {
  local controller=$1
  if [[ $controller == auto ]]; then
    bluetoothctl list 2>/dev/null | grep -q '^Controller '
  else
    bluetoothctl list 2>/dev/null | grep -Fqi "Controller $controller "
  fi
}

controller_batch() {
  local controller=$1 timeout=$2
  shift 2
  {
    [[ $controller == auto ]] || printf 'select %s\n' "$controller"
    printf '%s\n' "$@"
    printf 'quit\n'
  } | run_bounded_bluetoothctl "$timeout" --timeout "$timeout"
}

run_bounded_bluetoothctl() {
  local timeout=$1
  shift
  timeout --signal=TERM --kill-after=1 "$timeout" bluetoothctl "$@"
}

bluetooth_device_command_on_controller() {
  local controller=$1 timeout=$2 verb=$3 mac=$4
  controller_batch "$controller" "$timeout" "$verb $mac"
}

bluetooth_device_command() {
  bluetooth_device_command_on_controller "$CFG_CONTROLLER" "$@"
}

configured_bluetooth_devices() {
  if [[ $CFG_CONTROLLER == auto ]]; then
    bluetoothctl devices
  else
    controller_batch "$CFG_CONTROLLER" 5 devices
  fi
}

configured_controller_address() {
  local line address first=''
  if [[ $CFG_CONTROLLER != auto ]]; then
    printf '%s\n' "$CFG_CONTROLLER"
    return 0
  fi
  while IFS= read -r line; do
    [[ $line =~ ^Controller[[:space:]]+(([[:xdigit:]]{2}:){5}[[:xdigit:]]{2}) ]] || continue
    address=${BASH_REMATCH[1]^^}
    [[ -n $first ]] || first=$address
    if [[ $line == *' [default]' ]]; then
      printf '%s\n' "$address"
      return 0
    fi
  done < <(bluetoothctl list 2>/dev/null || true)
  [[ -n $first ]] || return 1
  printf '%s\n' "$first"
}

controller_power_state() {
  local controller=$1 state
  if [[ $controller == auto ]]; then
    state=$(bluetoothctl show 2>/dev/null | awk '/^[[:space:]]*Powered:/ { print $2; exit }')
  else
    state=$(bluetoothctl show "$controller" 2>/dev/null | \
      awk '/^[[:space:]]*Powered:/ { print $2; exit }')
  fi
  case $state in
    yes|no) printf '%s\n' "$state" ;;
    *) return 1 ;;
  esac
}

controller_pairable_state() {
  local controller=$1 state
  if [[ $controller == auto ]]; then
    state=$(bluetoothctl show 2>/dev/null | awk '/^[[:space:]]*Pairable:/ { print $2; exit }')
  else
    state=$(bluetoothctl show "$controller" 2>/dev/null | \
      awk '/^[[:space:]]*Pairable:/ { print $2; exit }')
  fi
  case $state in
    yes|no) printf '%s\n' "$state" ;;
    *) return 1 ;;
  esac
}

restore_controller_pairable_state() {
  local controller=$1 original=$2 command restored
  case $original in
    yes) command='pairable on' ;;
    no) command='pairable off' ;;
    *) return 1 ;;
  esac
  controller_batch "$controller" 5 "$command" >/dev/null 2>&1 || return 1
  restored=$(controller_pairable_state "$controller" 2>/dev/null || true)
  [[ $restored == "$original" ]]
}

power_controller() {
  hard_blocked && {
    warn "Bluetooth is hard-blocked and cannot be enabled in software."
    return 1
  }
  rfkill unblock bluetooth >/dev/null 2>&1 || \
    warn "Could not clear every Bluetooth soft block; continuing with controller detection."
  if ! controller_exists "$CFG_CONTROLLER"; then
    if [[ $CFG_CONTROLLER == auto ]]; then
      warn "No Bluetooth controller is visible to BlueZ; check the adapter, kernel log, and firmware."
    else
      warn "Configured Bluetooth controller $CFG_CONTROLLER is not visible to BlueZ."
    fi
    return 1
  fi
  controller_batch "$CFG_CONTROLLER" 5 'power on' >/dev/null 2>&1 || {
    warn "Could not power on Bluetooth controller $CFG_CONTROLLER."
    return 1
  }
  [[ $(controller_power_state "$CFG_CONTROLLER" 2>/dev/null || true) == yes ]] || {
    warn "Could not power on Bluetooth controller $CFG_CONTROLLER."
    return 1
  }
}

scan_bredr() {
  {
    [[ $CFG_CONTROLLER == auto ]] || printf 'select %s\n' "$CFG_CONTROLLER"
    printf 'scan bredr\n'
    sleep "$SCAN_TIMEOUT"
    printf 'scan off\nquit\n'
  } | bluetoothctl --timeout "$((SCAN_TIMEOUT + 5))" >/dev/null 2>&1 || true
}

device_info_on_controller() {
  local controller=$1 mac=$2 output
  output=$(bluetooth_device_command_on_controller "$controller" 5 info "$mac" 2>/dev/null) || return 1
  grep -q '^[[:space:]]*Paired:' <<< "$output" || return 1
  printf '%s\n' "$output"
}

device_info() {
  device_info_on_controller "$CFG_CONTROLLER" "$1"
}

device_property_is_yes() {
  local mac=$1 property=$2
  device_info "$mac" | grep -q "^[[:space:]]*$property: yes$"
}

device_paired() { device_property_is_yes "$1" Paired; }
device_trusted() { device_property_is_yes "$1" Trusted; }
device_connected() { device_property_is_yes "$1" Connected; }

disconnect_bluetooth_device() {
  local mac=$1
  bluetooth_device_command "$CONNECT_TIMEOUT" disconnect "$mac" >/dev/null 2>&1 || true
  ! device_connected "$mac"
}

remove_bluetooth_device() {
  local mac=$1
  remove_bluetooth_device_on_controller "$CFG_CONTROLLER" "$mac"
}

remove_bluetooth_device_on_controller() {
  local controller=$1 mac=$2
  bluetooth_device_command_on_controller "$controller" "$CONNECT_TIMEOUT" remove "$mac" \
    >/dev/null 2>&1 || true
  ! device_info_on_controller "$controller" "$mac" >/dev/null 2>&1
}

device_name() {
  device_name_on_controller "$CFG_CONTROLLER" "$1"
}

device_name_on_controller() {
  local controller=$1 mac=$2 name
  name=$(device_info_on_controller "$controller" "$mac" | \
    sed -n 's/^[[:space:]]*Name: //p' | head -n1)
  printf '%s\n' "${name:-unknown}"
}

find_a2dp_node_id() {
  local mac=$1 seconds=${2:-$CONNECT_TIMEOUT} mac_key line node
  [[ $seconds =~ ^[1-9][0-9]*$ ]] || return 1
  mac_key=${mac//:/_}
  line=$(bounded_user_wpctl "$CFG_AUDIO_USER" "$seconds" status --name 2>/dev/null | \
    grep -Fm1 "bluez_output.${mac_key}." || true)
  [[ -n $line ]] || return 1
  node=$(sed -E 's/^[^0-9]*([0-9]+)\..*/\1/' <<< "$line")
  [[ $node =~ ^[0-9]+$ ]] || return 1
  printf '%s\n' "$node"
}

valid_pipewire_name() {
  [[ $1 =~ ^[A-Za-z0-9_.:+-]+$ ]]
}

inspect_a2dp_sink_node() {
  local mac=$1 node=$2 seconds=$3 output line name='' class=''
  local name_pattern='^[[:space:]]*\*?[[:space:]]*node\.name[[:space:]]*=[[:space:]]*"([^"]+)"[[:space:]]*$'
  local class_pattern='^[[:space:]]*\*?[[:space:]]*media\.class[[:space:]]*=[[:space:]]*"([^"]+)"[[:space:]]*$'
  local mac_key=${mac//:/_}
  [[ $node =~ ^[0-9]+$ && $seconds =~ ^[1-9][0-9]*$ ]] || return 1
  output=$(bounded_user_wpctl "$CFG_AUDIO_USER" "$seconds" inspect "$node" 2>/dev/null) || return 1
  while IFS= read -r line; do
    if [[ $line =~ $name_pattern ]]; then
      [[ -z $name ]] || return 1
      name=${BASH_REMATCH[1]}
    elif [[ $line =~ $class_pattern ]]; then
      [[ -z $class ]] || return 1
      class=${BASH_REMATCH[1]}
    fi
  done <<< "$output"
  valid_pipewire_name "$name" || return 1
  [[ $class == Audio/Sink && $name == "bluez_output.${mac_key}."* ]] || return 1
  A2DP_SINK_NAME=$name
}

pipewire_default_sink() {
  local user=$1 seconds=$2 kind=$3 key output line name='' found=0 have_banner=0
  local pattern
  [[ $seconds =~ ^[1-9][0-9]*$ ]] || return 1
  case $kind in
    effective) key=default.audio.sink ;;
    configured) key=default.configured.audio.sink ;;
    *) return 1 ;;
  esac
  pattern="key:'${key//./\\.}'.*value:'\\{[[:space:]]*\"name\"[[:space:]]*:[[:space:]]*\"([A-Za-z0-9_.:+-]+)\"[[:space:]]*\\}'"
  output=$(bounded_user_pw_metadata "$user" "$seconds" -n default 0 "$key" 2>/dev/null) || return 1
  while IFS= read -r line; do
    [[ -n $line ]] || continue
    if [[ $line =~ $pattern ]]; then
      (( found == 0 )) || return 1
      name=${BASH_REMATCH[1]}
      valid_pipewire_name "$name" || return 1
      found=1
    elif [[ $line =~ ^Found[[:space:]]\"default\"[[:space:]]metadata[[:space:]][0-9]+$ ]]; then
      (( have_banner == 0 )) || return 1
      have_banner=1
    else
      return 1
    fi
  done <<< "$output"
  (( found == 1 )) || return 2
  printf '%s\n' "$name"
}

read_default_sink_state() {
  local user mac name extra
  [[ -e $DEFAULT_SINK_STATE_FILE || -L $DEFAULT_SINK_STATE_FILE ]] || return 2
  [[ -f $DEFAULT_SINK_STATE_FILE && ! -L $DEFAULT_SINK_STATE_FILE ]] || return 1
  IFS=$'\t' read -r user mac name extra < "$DEFAULT_SINK_STATE_FILE" || return 1
  [[ -z $extra && -n $user ]] || return 1
  id "$user" >/dev/null 2>&1 || return 1
  valid_mac "$mac" && [[ $mac == "${mac^^}" ]] || return 1
  valid_pipewire_name "$name" || return 1
  DEFAULT_STATE_USER=$user
  DEFAULT_STATE_MAC=$mac
  DEFAULT_STATE_NAME=$name
}

write_default_sink_state() {
  local user=$1 mac=$2 name=$3 temp
  id "$user" >/dev/null 2>&1 || return 1
  valid_mac "$mac" || return 1
  mac=$(normalize_mac "$mac")
  valid_pipewire_name "$name" || return 1
  [[ ! -e $DEFAULT_SINK_STATE_FILE && ! -L $DEFAULT_SINK_STATE_FILE ||
     -f $DEFAULT_SINK_STATE_FILE && ! -L $DEFAULT_SINK_STATE_FILE ]] || return 1
  temp=$(mktemp "$STATE_DIR/.default-sink.XXXXXX") || return 1
  if ! printf '%s\t%s\t%s\n' "$user" "$mac" "$name" > "$temp" ||
     ! chmod 0600 "$temp" || ! mv -f -- "$temp" "$DEFAULT_SINK_STATE_FILE"; then
    rm -f -- "$temp"
    return 1
  fi
}

remove_default_sink_state() {
  [[ ! -L $DEFAULT_SINK_STATE_FILE ]] || return 1
  rm -f -- "$DEFAULT_SINK_STATE_FILE"
}

select_speaker_default() {
  local mac=$1 seconds=${2:-$DEFAULT_SELECTION_TIMEOUT} deadline remaining node current configured result
  DEFAULT_SINK_ERROR=
  [[ $seconds =~ ^[1-9][0-9]*$ ]] || return 1
  valid_mac "$mac" || return 1
  mac=$(normalize_mac "$mac")
  deadline=$(( $(now_seconds) + seconds ))
  remaining=$(seconds_until_deadline "$deadline") || return 1
  node=$(find_a2dp_node_id "$mac" "$remaining") || {
    DEFAULT_SINK_ERROR="could not locate the A2DP sink for $mac"
    return 1
  }
  [[ $node =~ ^[0-9]+$ ]] || return 1
  remaining=$(seconds_until_deadline "$deadline") || return 1
  inspect_a2dp_sink_node "$mac" "$node" "$remaining" || {
    DEFAULT_SINK_ERROR="could not validate the A2DP sink for $mac"
    return 1
  }
  local sink_name=$A2DP_SINK_NAME
  remaining=$(seconds_until_deadline "$deadline") || return 1
  if current=$(pipewire_default_sink "$CFG_AUDIO_USER" "$remaining" effective); then
    result=0
  else
    result=$?
    current=
  fi
  if (( result == 0 )) && [[ $current == "$sink_name" ]]; then
    if read_default_sink_state 2>/dev/null; then
      if [[ $DEFAULT_STATE_USER == "$CFG_AUDIO_USER" &&
            $DEFAULT_STATE_MAC == "$mac" && $DEFAULT_STATE_NAME == "$sink_name" ]]; then
        return 0
      fi
      [[ $DEFAULT_STATE_USER == "$CFG_AUDIO_USER" ]] || {
        DEFAULT_SINK_ERROR="the recorded PipeWire default belongs to another audio user"
        return 1
      }
      remaining=$(seconds_until_deadline "$deadline") || return 1
      if configured=$(pipewire_default_sink "$CFG_AUDIO_USER" "$remaining" configured); then
        result=0
      else
        result=$?
        configured=
      fi
      if (( result == 0 )) && [[ $configured == "$DEFAULT_STATE_NAME" ]]; then
        : # Replace the configured default that A2DPilot still owns below.
      elif (( result == 0 || result == 2 )); then
        remove_default_sink_state || {
          DEFAULT_SINK_ERROR="could not retire stale PipeWire default ownership"
          return 1
        }
        return 0
      else
        DEFAULT_SINK_ERROR="could not inspect PipeWire's configured default sink"
        return 1
      fi
    else
      result=$?
      (( result == 2 )) && return 0
      DEFAULT_SINK_ERROR="could not read PipeWire default ownership"
      return 1
    fi
  fi
  (( result == 0 || result == 2 )) || {
    DEFAULT_SINK_ERROR="could not inspect PipeWire's effective default sink"
    return 1
  }
  remaining=$(seconds_until_deadline "$deadline") || return 1
  bounded_user_wpctl "$CFG_AUDIO_USER" "$remaining" set-default "$node" >/dev/null 2>&1 || {
    DEFAULT_SINK_ERROR="could not select $sink_name as PipeWire's default sink"
    return 1
  }
  remaining=$(seconds_until_deadline "$deadline") || return 1
  current=$(pipewire_default_sink "$CFG_AUDIO_USER" "$remaining" effective) || {
    DEFAULT_SINK_ERROR="could not verify PipeWire's effective default sink"
    return 1
  }
  [[ $current == "$sink_name" ]] || {
    DEFAULT_SINK_ERROR="PipeWire did not make $sink_name the effective default sink"
    return 1
  }
  remaining=$(seconds_until_deadline "$deadline") || return 1
  configured=$(pipewire_default_sink "$CFG_AUDIO_USER" "$remaining" configured) || {
    DEFAULT_SINK_ERROR="could not verify PipeWire's configured default sink"
    return 1
  }
  [[ $configured == "$sink_name" ]] || {
    DEFAULT_SINK_ERROR="PipeWire did not make $sink_name the configured default sink"
    return 1
  }
  write_default_sink_state "$CFG_AUDIO_USER" "$mac" "$sink_name" || {
    DEFAULT_SINK_ERROR="could not record ownership of PipeWire's default sink"
    return 1
  }
}

clear_recorded_default_sink() {
  local wanted_user=${1:-} wanted_mac=${2:-} current result
  if read_default_sink_state; then
    result=0
  else
    result=$?
    (( result == 2 )) && return 0
    return 1
  fi
  [[ -z $wanted_user || $DEFAULT_STATE_USER == "$wanted_user" ]] || return 0
  if [[ -n $wanted_mac ]]; then
    valid_mac "$wanted_mac" || return 1
    wanted_mac=$(normalize_mac "$wanted_mac")
    [[ $DEFAULT_STATE_MAC == "$wanted_mac" ]] || return 0
  fi
  if current=$(pipewire_default_sink "$DEFAULT_STATE_USER" "$DEFAULT_SELECTION_TIMEOUT" configured); then
    result=0
  else
    result=$?
    current=
  fi
  if (( result == 2 )) || { (( result == 0 )) && [[ $current != "$DEFAULT_STATE_NAME" ]]; }; then
    remove_default_sink_state
    return
  fi
  (( result == 0 )) || return 1
  bounded_user_wpctl "$DEFAULT_STATE_USER" "$DEFAULT_SELECTION_TIMEOUT" \
    clear-default 0 >/dev/null 2>&1 || return 1
  if current=$(pipewire_default_sink "$DEFAULT_STATE_USER" "$DEFAULT_SELECTION_TIMEOUT" configured); then
    [[ $current != "$DEFAULT_STATE_NAME" ]] || return 1
  else
    result=$?
    (( result == 2 )) || return 1
  fi
  remove_default_sink_state
}

maintain_speaker_default() {
  local mac=$1 now
  if select_speaker_default "$mac" "$DEFAULT_SELECTION_TIMEOUT"; then
    DAEMON_NEXT_DEFAULT_LOG=0
    return 0
  fi
  now=$(now_seconds)
  if (( now >= DAEMON_NEXT_DEFAULT_LOG )); then
    [[ -n $DEFAULT_SINK_ERROR ]] || \
      DEFAULT_SINK_ERROR="could not select the active Bluetooth sink as PipeWire's default"
    daemon_log "$DEFAULT_SINK_ERROR; Bluetooth remains connected"
    DAEMON_NEXT_DEFAULT_LOG=$((now + DEFAULT_LOG_INTERVAL))
  fi
  return 0
}

valid_user_service_unit() {
  [[ $1 =~ ^[A-Za-z0-9_.@:+-]+\.service$ ]]
}

known_player_identity() {
  local pid=$1 comm='' executable='' identity
  [[ $pid =~ ^[1-9][0-9]*$ ]] || return 1
  [[ -r $PROC_ROOT/$pid/comm ]] || return 1
  IFS= read -r comm < "$PROC_ROOT/$pid/comm" || return 1
  if [[ -L $PROC_ROOT/$pid/exe ]]; then
    executable=$(readlink -- "$PROC_ROOT/$pid/exe" 2>/dev/null || true)
    executable=${executable##*/}
  fi
  identity=$comm
  case $identity in
    caldera-music) PLAYER_IDENTITY_LABEL='Caldera Music' ;;
    Plexamp|plexamp) PLAYER_IDENTITY_LABEL=Plexamp ;;
    *)
      identity=$executable
      case $identity in
        caldera-music) PLAYER_IDENTITY_LABEL='Caldera Music' ;;
        Plexamp|plexamp) PLAYER_IDENTITY_LABEL=Plexamp ;;
        *) return 1 ;;
      esac
      ;;
  esac
}

process_start_time() {
  local pid=$1 stat_line
  local -a fields=()
  [[ $pid =~ ^[1-9][0-9]*$ ]] || return 1
  IFS= read -r stat_line < "$PROC_ROOT/$pid/stat" || return 1
  [[ $stat_line == "$pid ("* && $stat_line == *") "* ]] || return 1
  stat_line=${stat_line##*) }
  read -r -a fields <<< "$stat_line"
  (( ${#fields[@]} >= 20 )) || return 1
  [[ ${fields[19]} =~ ^[1-9][0-9]*$ ]] || return 1
  printf '%s\n' "${fields[19]}"
}

process_cgroup_path() {
  local pid=$1 line path='' count=0
  [[ -r $PROC_ROOT/$pid/cgroup ]] || return 1
  while IFS= read -r line || [[ -n $line ]]; do
    [[ $line == 0::* ]] || return 1
    path=${line#0::}
    count=$((count + 1))
  done < "$PROC_ROOT/$pid/cgroup"
  (( count == 1 )) || return 1
  [[ $path == /* && $path != *[[:space:]]* ]] || return 1
  printf '%s\n' "$path"
}

inspect_active_user_service() {
  local user=$1 unit=$2 output line key value
  local load='' active='' control_group='' main_pid=''
  local load_seen=0 active_seen=0 group_seen=0 pid_seen=0
  valid_user_service_unit "$unit" || return 1
  output=$(bounded_user_systemctl "$user" "$PLAYER_DISCOVERY_TIMEOUT" show "$unit" \
    -p LoadState -p ActiveState -p ControlGroup -p MainPID 2>/dev/null) || return 1
  while IFS= read -r line; do
    [[ $line == *=* ]] || return 1
    key=${line%%=*}
    value=${line#*=}
    case $key in
      LoadState) (( load_seen++ == 0 )) || return 1; load=$value ;;
      ActiveState) (( active_seen++ == 0 )) || return 1; active=$value ;;
      ControlGroup) (( group_seen++ == 0 )) || return 1; control_group=$value ;;
      MainPID) (( pid_seen++ == 0 )) || return 1; main_pid=$value ;;
      *) return 1 ;;
    esac
  done <<< "$output"
  [[ $load == loaded && ( $active == active || $active == reloading ) ]] || return 1
  [[ $control_group == /* && $control_group != *[[:space:]]* ]] || return 1
  [[ $main_pid =~ ^[1-9][0-9]*$ ]] || return 1
  PLAYER_SERVICE_CONTROL_GROUP=$control_group
}

player_service_for_pid() {
  local user=$1 pid=$2 uid path prefix unit
  uid=$(id -u "$user") || return 1
  path=$(process_cgroup_path "$pid") || return 1
  prefix=/user.slice/user-${uid}.slice/user@${uid}.service/app.slice/
  [[ $path == "$prefix"* ]] || return 1
  unit=${path#"$prefix"}
  valid_user_service_unit "$unit" || return 1
  inspect_active_user_service "$user" "$unit" || return 1
  [[ $PLAYER_SERVICE_CONTROL_GROUP == "$path" ]] || return 1
  printf '%s\n' "$unit"
}

player_backend_for_pid() {
  local pid=$1 fd target line
  for fd in "$PROC_ROOT/$pid"/fd/*; do
    [[ -L $fd ]] || continue
    target=$(readlink -- "$fd" 2>/dev/null || true)
    [[ $target != /dev/snd/pcm* ]] || {
      printf 'direct ALSA\n'
      return 0
    }
  done
  if [[ -r $PROC_ROOT/$pid/maps ]]; then
    while IFS= read -r line || [[ -n $line ]]; do
      case $line in
        *'/libpipewire-'*|*'/alsa-lib/libasound_module_pcm_pipewire.so'*)
          printf 'PipeWire\n'
          return 0
          ;;
      esac
    done < "$PROC_ROOT/$pid/maps"
  fi
  printf 'unknown\n'
}

player_backend_rank() {
  case $1 in
    'direct ALSA') printf '3\n' ;;
    PipeWire) printf '2\n' ;;
    *) printf '1\n' ;;
  esac
}

discover_known_players() {
  local user=$1 uid directory pid owner label start_before start_after unit backend index rank old_rank
  local -A service_indexes=()
  PLAYER_SERVICE_UNITS=()
  PLAYER_SERVICE_LABELS=()
  PLAYER_SERVICE_BACKENDS=()
  PLAYER_MANUAL_PIDS=()
  PLAYER_MANUAL_LABELS=()
  PLAYER_MANUAL_BACKENDS=()
  uid=$(id -u "$user") || return 1
  for directory in "$PROC_ROOT"/[0-9]*; do
    [[ -d $directory ]] || continue
    pid=${directory##*/}
    [[ $pid =~ ^[1-9][0-9]*$ ]] || continue
    owner=$(stat -c %u -- "$directory" 2>/dev/null) || continue
    [[ $owner == "$uid" ]] || continue
    start_before=$(process_start_time "$pid" 2>/dev/null) || continue
    known_player_identity "$pid" || continue
    label=$PLAYER_IDENTITY_LABEL
    backend=$(player_backend_for_pid "$pid")
    if unit=$(player_service_for_pid "$user" "$pid"); then
      start_after=$(process_start_time "$pid" 2>/dev/null) || continue
      [[ $start_after == "$start_before" ]] || continue
      known_player_identity "$pid" || continue
      [[ $PLAYER_IDENTITY_LABEL == "$label" ]] || continue
      if [[ ${service_indexes[$unit]+present} ]]; then
        index=${service_indexes[$unit]}
        rank=$(player_backend_rank "$backend")
        old_rank=$(player_backend_rank "${PLAYER_SERVICE_BACKENDS[$index]}")
        (( rank <= old_rank )) || PLAYER_SERVICE_BACKENDS[index]=$backend
      else
        service_indexes[$unit]=${#PLAYER_SERVICE_UNITS[@]}
        PLAYER_SERVICE_UNITS+=("$unit")
        PLAYER_SERVICE_LABELS+=("$label")
        PLAYER_SERVICE_BACKENDS+=("$backend")
      fi
    else
      start_after=$(process_start_time "$pid" 2>/dev/null) || continue
      [[ $start_after == "$start_before" ]] || continue
      PLAYER_MANUAL_PIDS+=("$pid")
      PLAYER_MANUAL_LABELS+=("$label")
      PLAYER_MANUAL_BACKENDS+=("$backend")
    fi
  done
}

user_service_has_known_player() {
  local user=$1 unit=$2 label=$3 uid directory pid owner path start_before start_after
  uid=$(id -u "$user") || return 1
  inspect_active_user_service "$user" "$unit" || return 1
  for directory in "$PROC_ROOT"/[0-9]*; do
    [[ -d $directory ]] || continue
    pid=${directory##*/}
    owner=$(stat -c %u -- "$directory" 2>/dev/null) || continue
    [[ $owner == "$uid" ]] || continue
    start_before=$(process_start_time "$pid" 2>/dev/null) || continue
    known_player_identity "$pid" || continue
    [[ $PLAYER_IDENTITY_LABEL == "$label" ]] || continue
    path=$(process_cgroup_path "$pid" 2>/dev/null) || continue
    [[ $path == "$PLAYER_SERVICE_CONTROL_GROUP" ]] || continue
    start_after=$(process_start_time "$pid" 2>/dev/null) || continue
    [[ $start_after == "$start_before" ]] || continue
    return 0
  done
  return 1
}

restart_detected_player() {
  local user=$1 unit=$2 label=$3 deadline remaining
  valid_user_service_unit "$unit" || return 1
  user_service_has_known_player "$user" "$unit" "$label" || return 1
  deadline=$(( $(now_seconds) + PLAYER_RESTART_TIMEOUT ))
  remaining=$(seconds_until_deadline "$deadline") || return 1
  bounded_user_systemctl "$user" "$remaining" restart "$unit" >/dev/null 2>&1 || return 1
  remaining=$(seconds_until_deadline "$deadline") || return 1
  bounded_user_systemctl "$user" "$remaining" is-active --quiet "$unit" >/dev/null 2>&1
}

offer_player_restarts() {
  local user=$1 interactive=$2 index unit label backend
  discover_known_players "$user" || {
    warn "Could not inspect running Caldera or Plexamp instances."
    return 0
  }
  for index in "${!PLAYER_MANUAL_PIDS[@]}"; do
    warn "${PLAYER_MANUAL_LABELS[$index]} is running as PID ${PLAYER_MANUAL_PIDS[$index]} (${PLAYER_MANUAL_BACKENDS[$index]}) but could not be mapped safely to an active user service; restart it manually to reopen audio through PipeWire."
  done
  for index in "${!PLAYER_SERVICE_UNITS[@]}"; do
    unit=${PLAYER_SERVICE_UNITS[$index]}
    label=${PLAYER_SERVICE_LABELS[$index]}
    backend=${PLAYER_SERVICE_BACKENDS[$index]}
    if (( interactive == 0 )); then
      warn "$label is running as $unit ($backend). Restart it manually to reopen audio through PipeWire; non-interactive installation never restarts players."
      continue
    fi
    tty_print '\n%s is running as %s.\n' "$label" "$unit"
    if tty_confirm $'Restart it now so it reopens audio through PipeWire?\nPlayback may resume paused.'; then
      if restart_detected_player "$user" "$unit" "$label"; then
        note "Restarted $unit."
      else
        warn "Could not safely restart $unit; restart it manually."
      fi
    else
      note "Left $unit running."
    fi
  done
}

print_known_player_status() {
  local index
  if ! discover_known_players "$CFG_AUDIO_USER"; then
    note "Known players: unavailable"
    return 0
  fi
  if (( ${#PLAYER_SERVICE_UNITS[@]} == 0 && ${#PLAYER_MANUAL_PIDS[@]} == 0 )); then
    note "Known players: none"
    return 0
  fi
  for index in "${!PLAYER_SERVICE_UNITS[@]}"; do
    note "Known player: ${PLAYER_SERVICE_LABELS[$index]} (${PLAYER_SERVICE_UNITS[$index]}, ${PLAYER_SERVICE_BACKENDS[$index]})"
  done
  for index in "${!PLAYER_MANUAL_PIDS[@]}"; do
    note "Known player: ${PLAYER_MANUAL_LABELS[$index]} (PID ${PLAYER_MANUAL_PIDS[$index]}, no safe user service, ${PLAYER_MANUAL_BACKENDS[$index]})"
  done
}

a2dp_connected() {
  find_a2dp_node_id "$1" "${2:-$CONNECT_TIMEOUT}" >/dev/null
}

a2dp_codec() {
  local mac=$1 seconds=${2:-$CONNECT_TIMEOUT} deadline remaining node codec output
  [[ $seconds =~ ^[1-9][0-9]*$ ]] || return 1
  deadline=$(( $(now_seconds) + seconds ))
  remaining=$(seconds_until_deadline "$deadline") || return 1
  node=$(find_a2dp_node_id "$mac" "$remaining") || return 1
  remaining=$(seconds_until_deadline "$deadline") || return 1
  output=$(bounded_user_wpctl "$CFG_AUDIO_USER" "$remaining" inspect "$node" 2>/dev/null) || return 1
  codec=$(awk -F'= ' '/api\.bluez5\.codec/ { gsub(/"/, "", $2); print $2; exit }' <<< "$output")
  if [[ -z $codec ]]; then
    remaining=$(seconds_until_deadline "$deadline") || return 1
    output=$(bounded_user_wpctl "$CFG_AUDIO_USER" "$remaining" \
      inspect --associated "$node" 2>/dev/null) || return 1
    codec=$(awk -F'= ' '/api\.bluez5\.codec/ { gsub(/"/, "", $2); print $2; exit }' <<< "$output")
  fi
  printf '%s\n' "${codec:-unknown}"
}

find_a2dp_device_id() {
  local mac=$1 seconds=$2 mac_key line
  mac_key=${mac//:/_}
  line=$(bounded_user_wpctl "$CFG_AUDIO_USER" "$seconds" status --name 2>/dev/null | \
    grep -Fm1 "bluez_card.${mac_key}" || true)
  [[ -n $line ]] || return 1
  sed -E 's/^[^0-9]*([0-9]+)\..*/\1/' <<< "$line"
}

print_a2dp_profile() {
  local index=$1 name=$2 codec_id codec
  [[ $index =~ ^[0-9]+$ ]] || return 0
  [[ $name == a2dp-sink || $name == a2dp-sink-* ]] || return 0
  codec_id=$((index & 65535))
  codec=$(a2dp_codec_name "$codec_id") || return 0
  [[ $name == a2dp-sink || $name == "a2dp-sink-$codec" ]] || return 0
  printf '%s %s\n' "$codec" "$index"
}

enumerate_a2dp_profiles() {
  local device=$1 seconds=$2 output line profile
  local expecting='' profile_index='' profile_name='' parsed=0
  output=$(bounded_user_pw_cli "$CFG_AUDIO_USER" "$seconds" \
    enum-params "$device" EnumProfile 2>/dev/null) || return 1
  # pw-cli exposes EnumProfile as diagnostic text rather than a stable machine
  # schema. Parse only the exact Trixie shape and fail closed if it drifts.
  while IFS= read -r line; do
    if [[ $line =~ ^[[:space:]]*Object: ]]; then
      profile=$(print_a2dp_profile "$profile_index" "$profile_name")
      if [[ -n $profile ]]; then
        printf '%s\n' "$profile"
        parsed=1
      fi
      profile_index=
      profile_name=
      expecting=
    elif [[ $line == *'Param:Profile:index '* ]]; then
      expecting=index
    elif [[ $line == *'Param:Profile:name '* ]]; then
      expecting=name
    elif [[ $expecting == index && $line =~ ^[[:space:]]*Int[[:space:]]+([0-9]+)[[:space:]]*$ ]]; then
      profile_index=${BASH_REMATCH[1]}
      expecting=
    elif [[ $expecting == name && $line =~ ^[[:space:]]*String[[:space:]]+\"([^\"]+)\"[[:space:]]*$ ]]; then
      profile_name=${BASH_REMATCH[1]}
      expecting=
    elif [[ -n $expecting && -n $line ]]; then
      expecting=
    fi
  done <<< "$output"
  profile=$(print_a2dp_profile "$profile_index" "$profile_name")
  if [[ -n $profile ]]; then
    printf '%s\n' "$profile"
    parsed=1
  fi
  (( parsed == 1 ))
}

select_preferred_a2dp_profile() {
  local mac=$1 deadline=$2 policy profiles codec index extra wanted candidate remaining
  local -a codec_preferences=() available=()
  SELECTED_A2DP_CODEC=
  SELECTED_A2DP_PROFILE=
  SELECTED_A2DP_DEVICE=
  AVAILABLE_A2DP_CODECS=
  policy=$(speaker_codec_policy "$mac") || return 1
  [[ -n $policy ]] || return 1
  remaining=$((deadline - $(now_seconds)))
  (( remaining > 0 )) || return 1
  SELECTED_A2DP_DEVICE=$(find_a2dp_device_id "$mac" "$remaining") || return 1
  [[ $SELECTED_A2DP_DEVICE =~ ^[0-9]+$ ]] || return 1
  remaining=$((deadline - $(now_seconds)))
  (( remaining > 0 )) || return 1
  profiles=$(enumerate_a2dp_profiles "$SELECTED_A2DP_DEVICE" "$remaining") || return 1
  while read -r codec index extra; do
    [[ -z $extra && -n $codec && $index =~ ^[0-9]+$ ]] || continue
    available+=("$codec")
  done <<< "$profiles"
  AVAILABLE_A2DP_CODECS=${available[*]:-none}
  read -r -a codec_preferences <<< "$policy"
  for wanted in "${codec_preferences[@]}"; do
    while read -r codec index extra; do
      [[ -z $extra && $codec == "$wanted" && $index =~ ^[0-9]+$ ]] || continue
      candidate=$index
      SELECTED_A2DP_CODEC=$wanted
      SELECTED_A2DP_PROFILE=$candidate
      return 0
    done <<< "$profiles"
  done
  return 2
}

wait_for_a2dp_transport() {
  local mac=$1 deadline=$2 remaining
  while true; do
    if device_connected "$mac"; then
      remaining=$(seconds_until_deadline "$deadline") || return 1
      a2dp_connected "$mac" "$remaining" && return 0
    fi
    seconds_until_deadline "$deadline" >/dev/null || return 1
    sleep 1
  done
}

restore_automatic_codec_negotiation() {
  local mac=$1 deadline=$2 remaining
  remaining=$(seconds_until_deadline "$deadline") || {
    CODEC_POLICY_ERROR="automatic codec reset for $mac exceeded the connection deadline"
    return 1
  }
  bluetooth_device_command "$remaining" disconnect "$mac" >/dev/null 2>&1 || true
  while device_connected "$mac"; do
    seconds_until_deadline "$deadline" >/dev/null || {
      CODEC_POLICY_ERROR="could not disconnect $mac to restore automatic codec negotiation"
      return 1
    }
    sleep 1
  done
  remaining=$(seconds_until_deadline "$deadline") || {
    CODEC_POLICY_ERROR="automatic codec reset for $mac exceeded the connection deadline"
    return 1
  }
  bluetooth_device_command "$remaining" connect "$mac" >/dev/null 2>&1 || {
    CODEC_POLICY_ERROR="could not reconnect $mac for automatic codec negotiation"
    return 1
  }
  wait_for_health "$mac" "$deadline" || {
    CODEC_POLICY_ERROR="automatic codec negotiation did not become healthy for $mac"
    return 1
  }
}

apply_speaker_codec_policy() {
  local mac=$1 deadline=$2 policy current remaining profile_json result
  CODEC_POLICY_ERROR=
  policy=$(speaker_codec_policy "$mac") || return 1
  if [[ -z $policy ]]; then
    if [[ -n ${DAEMON_CODEC_POLICY[$mac]:-} ]]; then
      restore_automatic_codec_negotiation "$mac" "$deadline" || return 1
      remember_daemon_codec_policy "$mac" '' || {
        CODEC_POLICY_ERROR="could not clear the recorded codec policy for $mac"
        return 1
      }
    fi
    unset "DAEMON_CODEC_POLICY[$mac]" "DAEMON_CODEC_TARGET[$mac]"
    wait_for_health "$mac" "$deadline"
    return
  fi

  wait_for_a2dp_transport "$mac" "$deadline" || {
    CODEC_POLICY_ERROR="A2DP transport for $mac did not become ready"
    return 1
  }
  remaining=$(seconds_until_deadline "$deadline") || {
    CODEC_POLICY_ERROR="codec inspection for $mac exceeded the connection deadline"
    return 1
  }
  current=$(a2dp_codec "$mac" "$remaining" 2>/dev/null || printf unknown)
  if [[ ${DAEMON_CODEC_POLICY[$mac]:-} == "$policy" &&
        ${DAEMON_CODEC_TARGET[$mac]:-} == "$current" ]]; then
    wait_for_health "$mac" "$deadline"
    return
  fi

  remaining=$(seconds_until_deadline "$deadline") || {
    CODEC_POLICY_ERROR="codec discovery for $mac exceeded the connection deadline"
    return 1
  }
  if select_preferred_a2dp_profile "$mac" "$deadline"; then
    result=0
  else
    result=$?
  fi
  if (( result == 2 )); then
    CODEC_POLICY_ERROR="none of the configured codecs for $mac are available (requested: $policy; available: $AVAILABLE_A2DP_CODECS)"
    return 2
  elif (( result != 0 )); then
    CODEC_POLICY_ERROR="could not discover available A2DP codecs for $mac"
    return 1
  fi

  remaining=$(seconds_until_deadline "$deadline") || {
    CODEC_POLICY_ERROR="codec inspection for $mac exceeded the connection deadline"
    return 1
  }
  current=$(a2dp_codec "$mac" "$remaining" 2>/dev/null || printf unknown)
  if [[ $current != "$SELECTED_A2DP_CODEC" ]]; then
    remaining=$(seconds_until_deadline "$deadline") || {
      CODEC_POLICY_ERROR="codec selection for $mac exceeded the connection deadline (requested: $policy; available: $AVAILABLE_A2DP_CODECS)"
      return 1
    }
    printf -v profile_json '{ index: %s, save: false }' "$SELECTED_A2DP_PROFILE"
    if ! bounded_user_pw_cli "$CFG_AUDIO_USER" "$remaining" set-param \
      "$SELECTED_A2DP_DEVICE" Profile "$profile_json" >/dev/null 2>&1; then
      CODEC_POLICY_ERROR="could not select $SELECTED_A2DP_CODEC for $mac (requested: $policy; available: $AVAILABLE_A2DP_CODECS)"
      return 1
    fi
  fi

  while true; do
    remaining=$(seconds_until_deadline "$deadline") || {
      CODEC_POLICY_ERROR="codec $SELECTED_A2DP_CODEC did not become healthy for $mac (requested: $policy; available: $AVAILABLE_A2DP_CODECS)"
      return 1
    }
    current=$(a2dp_codec "$mac" "$remaining" 2>/dev/null || printf unknown)
    remaining=$(seconds_until_deadline "$deadline") || {
      CODEC_POLICY_ERROR="codec $SELECTED_A2DP_CODEC did not become healthy for $mac (requested: $policy; available: $AVAILABLE_A2DP_CODECS)"
      return 1
    }
    if [[ $current == "$SELECTED_A2DP_CODEC" ]] && device_healthy "$mac" "$remaining"; then
      remember_daemon_codec_policy "$mac" "$policy" || {
        CODEC_POLICY_ERROR="could not record the active codec policy for $mac"
        return 1
      }
      DAEMON_CODEC_POLICY[$mac]=$policy
      DAEMON_CODEC_TARGET[$mac]=$SELECTED_A2DP_CODEC
      return 0
    fi
    sleep 1
  done
}

configured_controller_path() {
  local address=$CFG_CONTROLLER line path property
  if [[ $address == auto ]]; then
    line=$(bluetoothctl list 2>/dev/null | sed -n '1p') || return 1
    [[ $line =~ ^Controller[[:space:]]+(([[:xdigit:]]{2}:){5}[[:xdigit:]]{2}) ]] || return 1
    address=${BASH_REMATCH[1]^^}
  fi
  while IFS= read -r path; do
    [[ $path =~ ^/org/bluez/hci[0-9]+$ ]] || continue
    property=$(busctl get-property org.bluez "$path" org.bluez.Adapter1 Address 2>/dev/null) || continue
    [[ $property =~ ^s[[:space:]]+\"(([[:xdigit:]]{2}:){5}[[:xdigit:]]{2})\"$ ]] || continue
    [[ ${BASH_REMATCH[1]^^} == "$address" ]] || continue
    printf '%s\n' "$path"
    return 0
  done < <(busctl tree --list org.bluez 2>/dev/null || true)
  return 1
}

avrcp_connected() {
  local mac=$1 mac_key controller_path device_path
  mac_key=${mac//:/_}
  controller_path=$(configured_controller_path) || return 1
  device_path=$controller_path/dev_$mac_key
  busctl get-property org.bluez "$device_path" org.bluez.MediaControl1 Connected 2>/dev/null | \
    grep -q '^b true$'
}

device_healthy() {
  local mac=$1 seconds=${2:-$CONNECT_TIMEOUT} deadline remaining
  [[ $seconds =~ ^[1-9][0-9]*$ ]] || return 1
  deadline=$(( $(now_seconds) + seconds ))
  device_connected "$mac" || return 1
  remaining=$(seconds_until_deadline "$deadline") || return 1
  a2dp_connected "$mac" "$remaining" || return 1
  [[ $CFG_MEDIA_CONTROLS != required ]] || avrcp_connected "$mac"
}

speaker_configured() {
  local wanted=$1 mac
  for mac in "${CFG_SPEAKERS[@]}"; do
    [[ $mac == "$wanted" ]] && return 0
  done
  return 1
}

speaker_codec_policy() {
  local wanted=$1 index
  for index in "${!CFG_SPEAKERS[@]}"; do
    [[ ${CFG_SPEAKERS[$index]} == "$wanted" ]] || continue
    printf '%s\n' "${CFG_SPEAKER_CODECS[$index]:-}"
    return 0
  done
  return 1
}

speaker_codec_policy_display() {
  local policy
  policy=$(speaker_codec_policy "$1") || return 1
  if [[ -z $policy ]]; then
    printf 'auto\n'
  else
    printf '%s\n' "${policy// />}"
  fi
}

append_unique_line() {
  local path=$1 value=$2
  [[ -f $path ]] && grep -Fxq -- "$value" "$path" && return 0
  printf '%s\n' "$value" >> "$path"
}

remove_created_bond_records_for_mac() {
  local wanted=$1 path=$STATE_DIR/created-bonds temp controller mac extra
  [[ -f $path ]] || return 0
  temp=$(mktemp "$STATE_DIR/.lines.XXXXXX") || return 1
  while read -r controller mac extra; do
    [[ -z $extra && -n $controller && -n $mac ]] || {
      rm -f -- "$temp"
      return 1
    }
    if ! valid_mac "$controller" || ! valid_mac "$mac"; then
      rm -f -- "$temp"
      return 1
    fi
    [[ $mac == "$wanted" ]] || printf '%s %s\n' "$controller" "$mac" >> "$temp"
  done < "$path"
  mv -f -- "$temp" "$path"
}

remove_recorded_bonds_for_speaker() {
  local wanted=$1 controller mac extra failed=0
  [[ -f $STATE_DIR/created-bonds ]] || return 0
  while read -r controller mac extra; do
    [[ -z $extra ]] || return 1
    valid_mac "$controller" || return 1
    valid_mac "$mac" || return 1
    [[ $mac == "$wanted" ]] || continue
    if device_info_on_controller "$controller" "$mac" >/dev/null 2>&1 &&
       ! remove_bluetooth_device_on_controller "$controller" "$mac"; then
      warn "Could not remove A2DPilot-created bond $mac from controller $controller."
      failed=1
    fi
  done < "$STATE_DIR/created-bonds"
  (( failed == 0 )) || return 1
  remove_created_bond_records_for_mac "$wanted"
}

append_speaker_to_config() {
  local mac=$1 directory temp
  parse_config "$CONFIG_FILE" || return 1
  speaker_configured "$mac" && return 0
  directory=$(dirname "$CONFIG_FILE")
  temp=$(mktemp "$directory/.a2dpilot-config.XXXXXX") || return 1
  cp -- "$CONFIG_FILE" "$temp"
  printf '\nspeaker = %s\n' "$mac" >> "$temp"
  parse_config "$temp" || {
    rm -f -- "$temp"
    return 1
  }
  atomic_install_file "$temp" "$CONFIG_FILE" 0644
  local rc=$?
  rm -f -- "$temp"
  return "$rc"
}

remove_speaker_from_config() {
  local wanted=$1 directory temp raw line key value speaker_mac
  directory=$(dirname "$CONFIG_FILE")
  temp=$(mktemp "$directory/.a2dpilot-config.XXXXXX") || return 1
  while IFS= read -r raw || [[ -n $raw ]]; do
    line=$(trim "$raw")
    if [[ $line == *=* ]]; then
      key=$(trim "${line%%=*}")
      value=$(trim "${line#*=}")
      if [[ $key == speaker ]]; then
        speaker_mac=${value%%[[:space:]]*}
        if valid_mac "$speaker_mac" && [[ ${speaker_mac^^} == "$wanted" ]]; then
          continue
        fi
      fi
    fi
    printf '%s\n' "$raw" >> "$temp"
  done < "$CONFIG_FILE"
  parse_config "$temp" || {
    rm -f -- "$temp"
    return 1
  }
  atomic_install_file "$temp" "$CONFIG_FILE" 0644
  local rc=$?
  rm -f -- "$temp"
  return "$rc"
}

valid_agent() {
  case $1 in
    DisplayOnly|DisplayYesNo|KeyboardDisplay|KeyboardOnly|NoInputNoOutput) return 0 ;;
    *) return 1 ;;
  esac
}

wait_for_device_connection() {
  local mac=$1 deadline=${2:-}
  [[ -n $deadline ]] || deadline=$(( $(now_seconds) + CONNECT_TIMEOUT ))
  while true; do
    device_connected "$mac" && return 0
    (( $(now_seconds) < deadline )) || return 1
    sleep 1
  done
}

pair_on_controller() {
  local mac=$1 agent=$2
  local pair_pid='' coproc_input_fd coproc_output_fd input_fd='' output_fd=''
  local tty_output='' forward_pid='' char output_buffer=''
  local result=1 completed=0 interactive=0 original_pairable cleanup_done=0
  local owns_exit_trap=0 owns_hup_trap=0 owns_int_trap=0 owns_term_trap=0

  cleanup_pairing_session() {
    (( cleanup_done == 0 )) || return 0
    cleanup_done=1
    (( owns_exit_trap == 0 )) || trap - EXIT
    (( owns_hup_trap == 0 )) || trap - HUP
    (( owns_int_trap == 0 )) || trap - INT
    (( owns_term_trap == 0 )) || trap - TERM
    if [[ -n $forward_pid ]]; then
      kill "$forward_pid" 2>/dev/null || true
      wait "$forward_pid" 2>/dev/null || true
      forward_pid=
    fi
    if [[ -n $input_fd ]]; then
      exec {input_fd}>&- || true
      input_fd=
    fi
    if [[ -n $output_fd ]]; then
      exec {output_fd}<&- || true
      output_fd=
    fi
    if [[ -n $tty_output ]]; then
      exec {tty_output}>&- || true
      tty_output=
    fi
    if [[ -n $pair_pid ]]; then
      kill "$pair_pid" 2>/dev/null || true
      wait "$pair_pid" 2>/dev/null || true
      pair_pid=
    fi
    restore_controller_pairable_state "$CFG_CONTROLLER" "$original_pairable" || \
      warn "Could not restore the controller's pairable state."
  }

  original_pairable=$(controller_pairable_state "$CFG_CONTROLLER") || {
    warn "Could not determine the controller's pairable state; refusing to change it."
    return 1
  }
  if [[ -z $(trap -p EXIT) ]]; then
    trap cleanup_pairing_session EXIT
    owns_exit_trap=1
  fi
  if [[ -z $(trap -p HUP) ]]; then
    trap 'cleanup_pairing_session; exit 129' HUP
    owns_hup_trap=1
  fi
  if [[ -z $(trap -p INT) ]]; then
    trap 'cleanup_pairing_session; exit 130' INT
    owns_int_trap=1
  fi
  if [[ -z $(trap -p TERM) ]]; then
    trap 'cleanup_pairing_session; exit 143' TERM
    owns_term_trap=1
  fi
  has_tty && interactive=1
  coproc A2DPILOT_PAIR_SESSION {
    run_bounded_bluetoothctl 60 --agent "$agent" 2>&1
  }
  pair_pid=$A2DPILOT_PAIR_SESSION_PID
  coproc_input_fd=${A2DPILOT_PAIR_SESSION[1]}
  coproc_output_fd=${A2DPILOT_PAIR_SESSION[0]}
  exec {input_fd}>&"$coproc_input_fd"
  exec {output_fd}<&"$coproc_output_fd"
  exec {coproc_input_fd}>&-
  exec {coproc_output_fd}<&-
  if (( interactive )); then
    exec {tty_output}> /dev/tty
  fi
  [[ $CFG_CONTROLLER == auto ]] || printf 'select %s\n' "$CFG_CONTROLLER" >&"$input_fd"
  printf 'pairable on\npair %s\n' "$mac" >&"$input_fd"
  if (( interactive )); then
    cat /dev/tty >&"$input_fd" &
    forward_pid=$!
  fi

  while IFS= read -r -N 1 char <&"$output_fd"; do
    if (( interactive )); then
      printf '%s' "$char" >&"$tty_output"
    else
      printf '%s' "$char"
    fi
    output_buffer+=$char
    (( ${#output_buffer} <= 512 )) || output_buffer=${output_buffer: -512}
    if (( completed == 0 )) && [[ $output_buffer == *'Pairing successful'* ]]; then
      result=0
      completed=1
    elif (( completed == 0 )) && \
         [[ $output_buffer == *'Failed to pair'* || $output_buffer == *' not available'* ]]; then
      completed=1
    fi
    if (( completed == 1 )); then
      if (( interactive )); then
        printf '\n' >&"$tty_output"
      else
        printf '\n'
      fi
      break
    fi
  done
  cleanup_pairing_session
  unset -f cleanup_pairing_session
  return "$result"
}

pair_one() {
  local mac=$1 agent=$2 was_paired=0 deadline bond_controller=''
  device_paired "$mac" && was_paired=1
  if (( was_paired == 0 )); then
    bond_controller=$(configured_controller_address) || return 1
    note "Scanning for $mac; put the speaker in pairing mode..."
    scan_bredr
    pair_on_controller "$mac" "$agent" || return 1
    note "Pairing succeeded; finalizing trust and connection..."
    device_paired "$mac" || return 1
    append_unique_line "$STATE_DIR/created-bonds" "$bond_controller $mac" || return 1
  fi
  if ! device_trusted "$mac"; then
    bluetooth_device_command 10 trust "$mac" >/dev/null 2>&1 || true
    device_trusted "$mac" || return 1
  fi
  deadline=$(( $(now_seconds) + CONNECT_TIMEOUT ))
  bluetooth_device_command "$CONNECT_TIMEOUT" connect "$mac" >/dev/null 2>&1 || true
  device_paired "$mac" && device_trusted "$mac" && \
    wait_for_device_connection "$mac" "$deadline" || return 1
  append_speaker_to_config "$mac" || return 1
  if (( was_paired )); then
    note "Using existing trusted bond for $mac."
  else
    note "Paired and trusted $mac."
  fi
}

interactive_pair_loop() {
  local choice index mac agent=$1 line
  local -a devices=()
  while true; do
    note "Scanning for Bluetooth Classic audio devices..."
    scan_bredr
    devices=()
    while IFS= read -r line; do
      [[ $line =~ ^Device[[:space:]]+(([[:xdigit:]]{2}:){5}[[:xdigit:]]{2})[[:space:]]+(.+)$ ]] || continue
      mac=${BASH_REMATCH[1]^^}
      speaker_configured "$mac" && continue
      devices+=("$mac|${BASH_REMATCH[3]}")
    done < <(configured_bluetooth_devices 2>/dev/null || true)
    if (( ${#devices[@]} == 0 )); then
      note "No devices were discovered."
    else
      tty_print 'Discovered devices:\n'
      for index in "${!devices[@]}"; do
        tty_print '  %d) %s %s\n' "$((index + 1))" "${devices[$index]%%|*}" "${devices[$index]#*|}"
      done
    fi
    tty_print 'Select a device number, [r]escan, or press Enter to finish: '
    tty_read choice || return 0
    [[ -n $choice ]] || return 0
    [[ $choice == r || $choice == R ]] && continue
    [[ $choice =~ ^[0-9]+$ ]] || {
      warn "Invalid selection."
      continue
    }
    index=$((choice - 1))
    (( index >= 0 && index < ${#devices[@]} )) || {
      warn "Invalid selection."
      continue
    }
    mac=${devices[$index]%%|*}
    pair_one "$mac" "$agent" || warn "Could not pair $mac; it was not added."
  done
}

pair_action() {
  require_root
  [[ -f $STATE_FILE ]] || die "A2DPilot is not installed."
  local mode=interactive mac='' agent=''
  while [[ $# -gt 0 ]]; do
    case $1 in
      --all) [[ $mode == interactive && -z $mac ]] || die "Specify either a MAC address or --all."; mode=all; shift ;;
      --agent) [[ $# -ge 2 ]] || die "--agent requires a value."; agent=$2; shift 2 ;;
      --*) die "Unknown pair option: $1" ;;
      *) [[ -z $mac && $mode == interactive ]] || die "Only one MAC address may be paired at a time."; mac=$1; mode=one; shift ;;
    esac
  done
  [[ -z $mac ]] || valid_mac "$mac" || die "Invalid Bluetooth MAC address: $mac"
  [[ -z $mac ]] || mac=$(normalize_mac "$mac")
  if [[ -z $agent ]]; then
    if has_tty; then agent=KeyboardDisplay; else agent=NoInputNoOutput; fi
  fi
  valid_agent "$agent" || die "Unsupported BlueZ agent capability: $agent"
  [[ $mode != interactive ]] || has_tty || die "Interactive pairing requires a terminal or an explicit MAC address."

  acquire_lock
  parse_config "$CONFIG_FILE" || {
    local error=$CONFIG_ERROR
    release_lock
    die "$error"
  }
  power_controller || {
    release_lock
    die "No usable Bluetooth controller is available."
  }

  local failed=0 speaker
  case $mode in
    one) pair_one "$mac" "$agent" || failed=1 ;;
    all)
      for speaker in "${CFG_SPEAKERS[@]}"; do
        pair_one "$speaker" "$agent" || {
          warn "Could not provision $speaker."
          failed=1
        }
      done
      ;;
    interactive) interactive_pair_loop "$agent" || failed=1 ;;
  esac
  release_lock
  systemctl try-restart a2dpilot.service || failed=1
  (( failed == 0 )) || die "One or more speakers could not be provisioned."
}

forget_action() {
  require_root
  [[ -f $STATE_FILE ]] || die "A2DPilot is not installed."
  local mac='' assume_yes=0 answer
  while [[ $# -gt 0 ]]; do
    case $1 in
      --yes) assume_yes=1; shift ;;
      --*) die "Unknown forget option: $1" ;;
      *) [[ -z $mac ]] || die "Only one MAC address may be forgotten."; mac=$1; shift ;;
    esac
  done
  [[ -n $mac ]] || die "forget requires a Bluetooth MAC address."
  valid_mac "$mac" || die "Invalid Bluetooth MAC address: $mac"
  mac=$(normalize_mac "$mac")
  if (( assume_yes == 0 )); then
    has_tty || die "Use --yes when forgetting a device non-interactively."
    tty_print 'Forget %s and remove its Bluetooth bond? [y/N] ' "$mac"
    tty_read answer || answer=
    [[ $answer == y || $answer == Y || $answer == yes || $answer == YES ]] || {
      note "Device was not forgotten."
      return 0
    }
  fi

  acquire_lock
  parse_config "$CONFIG_FILE" || {
    local error=$CONFIG_ERROR
    release_lock
    die "$error"
  }
  clear_recorded_default_sink "$CFG_AUDIO_USER" "$mac" || \
    warn "Could not clear A2DPilot's recorded PipeWire default for $mac."
  disconnect_bluetooth_device "$mac" || true
  if device_info "$mac" >/dev/null 2>&1; then
    remove_bluetooth_device "$mac" || {
      release_lock
      die "BlueZ could not remove $mac; configuration was left unchanged."
    }
  fi
  remove_recorded_bonds_for_speaker "$mac" || {
    release_lock
    die "One or more A2DPilot-created bonds for $mac could not be removed."
  }
  remove_speaker_from_config "$mac" || {
    release_lock
    die "Could not remove $mac from the configuration."
  }
  release_lock
  systemctl try-restart a2dpilot.service || true
  note "Forgot $mac."
}

now_seconds() { date +%s; }

seconds_until_deadline() {
  local deadline=$1 now
  [[ $deadline =~ ^[0-9]+$ ]] || return 1
  now=$(now_seconds)
  (( deadline > now )) || return 1
  printf '%s\n' "$((deadline - now))"
}

connection_backoff() {
  local failures=$1 interval=$2 count=1
  local delay=$interval
  while (( count < failures && delay < 60 )); do
    delay=$((delay * 2))
    (( delay > 60 )) && delay=60
    count=$((count + 1))
  done
  printf '%s\n' "$delay"
}

wait_for_health() {
  local mac=$1 deadline=${2:-} remaining
  [[ -n $deadline ]] || deadline=$(( $(now_seconds) + CONNECT_TIMEOUT ))
  while true; do
    remaining=$(seconds_until_deadline "$deadline") || return 1
    device_healthy "$mac" "$remaining" && return 0
    seconds_until_deadline "$deadline" >/dev/null || return 1
    sleep 1
  done
}

wait_for_configured_speaker_default() {
  local seconds=${1:-$CONNECT_TIMEOUT} deadline remaining mac
  [[ $seconds =~ ^[1-9][0-9]*$ ]] || return 1
  (( ${#CFG_SPEAKERS[@]} > 0 )) || return 2
  deadline=$(( $(now_seconds) + seconds ))
  while remaining=$(seconds_until_deadline "$deadline"); do
    if mac=$(read_daemon_selected_speaker); then
      remaining=$(seconds_until_deadline "$deadline") || return 1
      if device_healthy "$mac" "$remaining"; then
        select_speaker_default "$mac" "$DEFAULT_SELECTION_TIMEOUT" || return 3
        return 0
      fi
    fi
    sleep 1
  done
  return 1
}

disconnect_other_speakers() {
  local winner=$1 mac
  for mac in "${CFG_SPEAKERS[@]}"; do
    [[ $mac == "$winner" ]] && continue
    device_connected "$mac" || continue
    disconnect_bluetooth_device "$mac" || warn "Could not disconnect stale speaker $mac."
    unset "DAEMON_CODEC_POLICY[$mac]" "DAEMON_CODEC_TARGET[$mac]"
  done
}

daemon_log() {
  printf '%s %s\n' "$(date -Is)" "$*"
}

remember_daemon_codec_policy() {
  local mac=$1 policy=${2:-} path=$STATE_DIR/active-codec-policy temp codec
  local -a codecs=()
  if [[ -z $policy ]]; then
    rm -f -- "$path"
    return 0
  fi
  valid_mac "$mac" || return 1
  read -r -a codecs <<< "$policy"
  (( ${#codecs[@]} > 0 )) || return 1
  for codec in "${codecs[@]}"; do
    valid_a2dp_codec "$codec" || return 1
  done
  temp=$(mktemp "$STATE_DIR/.active-codec-policy.XXXXXX") || return 1
  printf '%s\t%s\n' "$mac" "$policy" > "$temp"
  chmod 0600 "$temp"
  mv -f -- "$temp" "$path"
}

load_daemon_codec_policy() {
  local path=$STATE_DIR/active-codec-policy mac policy extra codec
  local -a codecs=()
  [[ -e $path || -L $path ]] || return 0
  if [[ ! -f $path || -L $path ]] ||
     ! IFS=$'\t' read -r mac policy extra < "$path" ||
     [[ -n $extra || -z $policy ]] ||
     ! valid_mac "$mac" || [[ $mac != "$DAEMON_ACTIVE" ]]; then
    rm -f -- "$path"
    return 0
  fi
  read -r -a codecs <<< "$policy"
  (( ${#codecs[@]} > 0 )) || {
    rm -f -- "$path"
    return 0
  }
  for codec in "${codecs[@]}"; do
    if ! valid_a2dp_codec "$codec"; then
      rm -f -- "$path"
      return 0
    fi
  done
  DAEMON_CODEC_POLICY[$mac]=$policy
}

remember_daemon_active() {
  local mac=${1:-} path=$STATE_DIR/active-speaker temp
  DAEMON_ACTIVE=$mac
  if [[ -z $mac ]]; then
    rm -f -- "$path"
    remember_daemon_codec_policy '' ''
    return 0
  fi
  valid_mac "$mac" || return 1
  temp=$(mktemp "$STATE_DIR/.active-speaker.XXXXXX") || return 1
  printf '%s\n' "$mac" > "$temp"
  chmod 0600 "$temp"
  mv -f -- "$temp" "$path"
}

load_daemon_active() {
  local path=$STATE_DIR/active-speaker saved
  [[ -z $DAEMON_ACTIVE && -f $path && ! -L $path ]] || return 0
  IFS= read -r saved < "$path" || saved=
  if valid_mac "$saved"; then
    DAEMON_ACTIVE=$(normalize_mac "$saved")
    load_daemon_codec_policy
  else
    rm -f -- "$path"
    remember_daemon_codec_policy '' ''
  fi
}

read_daemon_selected_speaker() {
  local path=$STATE_DIR/active-speaker mac
  local -a lines=()
  [[ -f $path && ! -L $path ]] || return 1
  mapfile -t lines < "$path" || return 1
  (( ${#lines[@]} == 1 )) || return 1
  mac=${lines[0]}
  valid_mac "$mac" || return 1
  mac=$(normalize_mac "$mac")
  speaker_configured "$mac" || return 1
  printf '%s\n' "$mac"
}

record_daemon_failure() {
  local mac=$1 message=$2 failures delay now
  now=$(now_seconds)
  failures=$(( ${DAEMON_FAILURES[$mac]:-0} + 1 ))
  DAEMON_FAILURES[$mac]=$failures
  delay=$(connection_backoff "$failures" "$CFG_RECONNECT_INTERVAL")
  DAEMON_NEXT_ATTEMPT[$mac]=$((now + delay))
  unset "DAEMON_CODEC_POLICY[$mac]" "DAEMON_CODEC_TARGET[$mac]"
  daemon_log "$message; retrying in ${delay}s"
}

daemon_cycle() {
  local mac now next deadline failure_message policy
  now=$(now_seconds)

  if [[ -n $DAEMON_ACTIVE ]]; then
    if ! speaker_configured "$DAEMON_ACTIVE"; then
      clear_recorded_default_sink "$CFG_AUDIO_USER" "$DAEMON_ACTIVE" || \
        warn "Could not clear A2DPilot's recorded PipeWire default for $DAEMON_ACTIVE."
      disconnect_bluetooth_device "$DAEMON_ACTIVE" || true
      unset "DAEMON_CODEC_POLICY[$DAEMON_ACTIVE]" "DAEMON_CODEC_TARGET[$DAEMON_ACTIVE]"
      remember_daemon_active ''
    elif device_connected "$DAEMON_ACTIVE" && a2dp_connected "$DAEMON_ACTIVE"; then
      deadline=$(( $(now_seconds) + CONNECT_TIMEOUT ))
      if apply_speaker_codec_policy "$DAEMON_ACTIVE" "$deadline"; then
        DAEMON_FAILURES[$DAEMON_ACTIVE]=0
        DAEMON_NEXT_ATTEMPT[$DAEMON_ACTIVE]=0
        maintain_speaker_default "$DAEMON_ACTIVE"
        disconnect_other_speakers "$DAEMON_ACTIVE"
        return 0
      fi
      failure_message=${CODEC_POLICY_ERROR:-"connection to $DAEMON_ACTIVE is not healthy"}
      disconnect_bluetooth_device "$DAEMON_ACTIVE" || true
      record_daemon_failure "$DAEMON_ACTIVE" "$failure_message"
      remember_daemon_active ''
    else
      unset "DAEMON_CODEC_POLICY[$DAEMON_ACTIVE]" "DAEMON_CODEC_TARGET[$DAEMON_ACTIVE]"
      remember_daemon_active ''
    fi
  fi

  # On restart, keep any already-healthy configured speaker instead of
  # preempting it with a higher-priority device.
  for mac in "${CFG_SPEAKERS[@]}"; do
    if device_healthy "$mac"; then
      policy=$(speaker_codec_policy "$mac") || continue
      next=${DAEMON_NEXT_ATTEMPT[$mac]:-0}
      # An automatic speaker needs no active policy work, so adopt a healthy
      # self-reconnection even while an earlier connection retry is cooling
      # down. Strict codec policy retries remain bounded by that cooldown.
      [[ -z $policy ]] || (( now >= next )) || continue
      deadline=$(( $(now_seconds) + CONNECT_TIMEOUT ))
      if apply_speaker_codec_policy "$mac" "$deadline"; then
        DAEMON_FAILURES[$mac]=0
        DAEMON_NEXT_ATTEMPT[$mac]=0
        remember_daemon_active "$mac"
        maintain_speaker_default "$mac"
        disconnect_other_speakers "$mac"
        return 0
      fi
      failure_message=${CODEC_POLICY_ERROR:-"connection to $mac is not healthy"}
      disconnect_bluetooth_device "$mac" || true
      record_daemon_failure "$mac" "$failure_message"
    fi
  done

  for mac in "${CFG_SPEAKERS[@]}"; do
    next=${DAEMON_NEXT_ATTEMPT[$mac]:-0}
    (( now >= next )) || continue
    if ! device_paired "$mac"; then
      daemon_log "$mac is not paired; run 'sudo a2dpilot pair $mac'."
      DAEMON_NEXT_ATTEMPT[$mac]=$((now + 60))
      continue
    fi
    if ! device_trusted "$mac"; then
      bluetooth_device_command 5 trust "$mac" >/dev/null 2>&1 || true
      if ! device_trusted "$mac"; then
        daemon_log "could not trust paired speaker $mac"
        DAEMON_NEXT_ATTEMPT[$mac]=$((now + 60))
        continue
      fi
    fi
    daemon_log "connecting $mac"
    deadline=$(( $(now_seconds) + CONNECT_TIMEOUT ))
    CODEC_POLICY_ERROR=
    if bluetooth_device_command "$CONNECT_TIMEOUT" connect "$mac" >/dev/null 2>&1 && \
       apply_speaker_codec_policy "$mac" "$deadline"; then
      remember_daemon_active "$mac"
      DAEMON_FAILURES[$mac]=0
      DAEMON_NEXT_ATTEMPT[$mac]=0
      maintain_speaker_default "$mac"
      disconnect_other_speakers "$mac"
      daemon_log "connected $mac with codec $(a2dp_codec "$mac" 2>/dev/null || printf unknown)"
      return 0
    fi
    failure_message=${CODEC_POLICY_ERROR:-"connection to $mac failed"}
    disconnect_bluetooth_device "$mac" || true
    record_daemon_failure "$mac" "$failure_message"
  done
}

daemon_action() {
  require_root
  prepare_media_state_directory || die "Could not prepare the media-control runtime directory."
  trap 'exit 0' TERM INT
  while true; do
    if ! acquire_lock 1; then
      sleep 1
      continue
    fi
    if parse_config "$CONFIG_FILE"; then
      DAEMON_HAVE_CONFIG=1
      DAEMON_LAST_CONFIG_ERROR=
      load_daemon_active
      if ! reconcile_runtime_configuration; then
        daemon_log "could not apply runtime configuration"
      elif ! power_controller; then
        daemon_log "no usable Bluetooth controller is available"
      else
        daemon_cycle
      fi
      release_lock
      sleep "$CFG_RECONNECT_INTERVAL"
    else
      if [[ $CONFIG_ERROR != "$DAEMON_LAST_CONFIG_ERROR" ]]; then
        daemon_log "$CONFIG_ERROR"
        DAEMON_LAST_CONFIG_ERROR=$CONFIG_ERROR
      fi
      if (( DAEMON_HAVE_CONFIG )); then
        daemon_cycle || true
        release_lock
        sleep "$CFG_RECONNECT_INTERVAL"
      else
        release_lock
        sleep 5
      fi
    fi
  done
}

media_now_us() {
  local target=$1 seconds fraction _ value
  [[ -f $MEDIA_MONOTONIC_CLOCK && ! -L $MEDIA_MONOTONIC_CLOCK ]] || return 1
  IFS=' .' read -r seconds fraction _ < "$MEDIA_MONOTONIC_CLOCK" || return 1
  [[ $seconds =~ ^[0-9]+$ && $fraction =~ ^[0-9]+$ ]] || return 1
  fraction=${fraction}000000
  fraction=${fraction:0:6}
  value=$((10#$seconds * 1000000 + 10#$fraction))
  printf -v "$target" '%s' "$value"
}

start_media_deadline() {
  local now_us
  media_now_us now_us || return 1
  MEDIA_DEADLINE_US=$((10#$now_us + MEDIA_ACTION_TIMEOUT * 1000000))
}

media_remaining_seconds() {
  local target=$1 now_us remaining_us_value
  media_now_us now_us || return 1
  remaining_us_value=$((MEDIA_DEADLINE_US - 10#$now_us))
  (( remaining_us_value > 0 )) || return 1
  printf -v "$target" '%d.%06d' \
    "$((remaining_us_value / 1000000))" "$((remaining_us_value % 1000000))"
}

import_media_deadline() {
  local inherited=${A2DPILOT_MEDIA_DEADLINE_US:-} now_us remaining_us
  [[ $inherited =~ ^[1-9][0-9]{0,17}$ ]] || return 1
  media_now_us now_us || return 1
  remaining_us=$((10#$inherited - 10#$now_us))
  (( remaining_us > 0 && remaining_us <= MEDIA_ACTION_TIMEOUT * 1000000 )) || return 1
  MEDIA_DEADLINE_US=$((10#$inherited))
  MEDIA_DEADLINE_INHERITED=1
}

media_invoking_as_root() {
  [[ ${EUID:-$(id -u)} -eq 0 ]]
}

bounded_player_control_action() {
  local remaining rc
  start_media_deadline || die "Could not start the media-control deadline."
  media_remaining_seconds remaining || die "The media-control request timed out."
  if media_invoking_as_root; then
    if timeout --signal=TERM --kill-after=0.1 "$remaining" \
        runuser -u "$MEDIA_RUNTIME_USER" -- env \
        A2DPILOT_MEDIA_DEADLINE_US="$MEDIA_DEADLINE_US" \
        "$SCRIPT_PATH" __player-control "$@"; then
      return 0
    else
      rc=$?
    fi
  else
    if A2DPILOT_MEDIA_DEADLINE_US=$MEDIA_DEADLINE_US \
        timeout --signal=TERM --kill-after=0.1 "$remaining" \
        "$SCRIPT_PATH" __player-control "$@"; then
      return 0
    else
      rc=$?
    fi
  fi
  case $rc in
    124|137) warn "The media-control request timed out." ;;
  esac
  return "$rc"
}

player_control_worker_action() {
  import_media_deadline || die "Invalid or expired media-control deadline."
  player_control_action "$@"
}

media_curl() {
  local now_us remaining_us remaining connect
  media_now_us now_us || return 1
  remaining_us=$((MEDIA_DEADLINE_US - 10#$now_us))
  (( remaining_us > 0 )) || return 1
  printf -v remaining '%d.%06d' "$((remaining_us / 1000000))" "$((remaining_us % 1000000))"
  if (( remaining_us > MEDIA_CONNECT_TIMEOUT * 1000000 )); then
    connect=$MEDIA_CONNECT_TIMEOUT
  else
    connect=$remaining
  fi
  curl --fail --silent --show-error --connect-timeout "$connect" --max-time "$remaining" "$@"
}

media_command_id() {
  local target=$1 wall_value=$EPOCHREALTIME seconds fraction milliseconds
  seconds=${wall_value%%.*}
  fraction=${wall_value#*.}000
  fraction=${fraction:0:3}
  [[ $seconds =~ ^[0-9]+$ && $fraction =~ ^[0-9]{3}$ ]] || return 1
  milliseconds=$((10#$seconds * 1000 + 10#$fraction))
  printf -v "$target" '%s' "$milliseconds"
}

media_url_for_key() {
  local wanted=$1 index template url command_id
  RESOLVED_MEDIA_URL=
  MEDIA_STATE_ACTION=
  for index in "${!CFG_MEDIA_KEYS[@]}"; do
    [[ ${CFG_MEDIA_KEYS[$index]} == "$wanted" ]] || continue
    media_command_id command_id || return 1
    template=${CFG_MEDIA_URLS[$index]}
    expand_player_state_tokens "$template" "$((10#$command_id - 1))" || return 1
    template=$EXPANDED_MEDIA_TEMPLATE
    if [[ $template == /* ]]; then
      [[ -n $CFG_BASE_URL ]] || return 1
      url=$CFG_BASE_URL$template
    else
      url=$template
    fi
    url=${url//\{command-id\}/$command_id}
    valid_http_url "$url" || return 1
    RESOLVED_MEDIA_URL=$url
    return 0
  done
  return 1
}

media_key_is_stateful() {
  local wanted=$1 index template
  for index in "${!CFG_MEDIA_KEYS[@]}"; do
    [[ ${CFG_MEDIA_KEYS[$index]} == "$wanted" ]] || continue
    template=${CFG_MEDIA_URLS[$index]}
    [[ $template == *'{volume-up}'* ||
       $template == *'{volume-down}'* ||
       $template == *'{mute-toggle}'* ||
       $template == *'{shuffle-toggle}'* ||
       $template == *'{repeat-cycle}'* ]]
    return
  done
  return 1
}

media_mute_state_path() {
  local digest
  [[ -n $CFG_BASE_URL ]] || return 1
  digest=$(printf '%s' "$CFG_BASE_URL" | sha256sum) || return 1
  digest=${digest%% *}
  [[ $digest =~ ^[0-9a-f]{64}$ ]] || return 1
  printf '%s/mute-%s\n' "$MEDIA_STATE_DIR" "$digest"
}

media_state_access_allowed() {
  local runtime_uid
  runtime_uid=$(id -u "$MEDIA_RUNTIME_USER") || return 1
  [[ ${EUID:-$(id -u)} -eq "$runtime_uid" ]]
}

media_effective_uid() {
  printf '%s\n' "${EUID:-$(id -u)}"
}

prepare_media_state_directory() {
  local owner parent parent_owner runtime_uid media_group effective_uid
  runtime_uid=$(id -u "$MEDIA_RUNTIME_USER") || return 1
  media_group=$(id -gn "$MEDIA_RUNTIME_USER") || return 1
  effective_uid=$(media_effective_uid) || return 1
  [[ $effective_uid =~ ^[0-9]+$ ]] || return 1
  parent=$(dirname "$MEDIA_STATE_DIR")
  validate_directory_chain "$parent"
  [[ -d $parent && ! -L $parent ]] || return 1
  parent_owner=$(stat -c %u "$parent") || return 1
  if (( 10#$effective_uid == 0 )); then
    [[ $parent_owner == 0 ]] || return 1
    chmod 0755 "$parent" || return 1
  else
    [[ $parent_owner == 0 || $parent_owner == "$runtime_uid" ]] || return 1
  fi
  validate_directory_chain "$MEDIA_STATE_DIR"
  if [[ ! -e $MEDIA_STATE_DIR ]]; then
    if (( 10#$effective_uid == 0 )); then
      install -d -o "$MEDIA_RUNTIME_USER" -g "$media_group" -m 0700 "$MEDIA_STATE_DIR" || return 1
    else
      install -d -m 0700 "$MEDIA_STATE_DIR" || return 1
    fi
  fi
  [[ -d $MEDIA_STATE_DIR && ! -L $MEDIA_STATE_DIR ]] || return 1
  owner=$(stat -c %u "$MEDIA_STATE_DIR") || return 1
  [[ $owner == "$runtime_uid" ]] || return 1
  chmod 0700 "$MEDIA_STATE_DIR"
}

read_media_mute_volume() {
  local path directory owner file_owner runtime_uid saved_base saved_volume _extra
  media_state_access_allowed || return 1
  runtime_uid=$(id -u "$MEDIA_RUNTIME_USER") || return 1
  path=$(media_mute_state_path) || return 1
  directory=$(dirname "$path")
  [[ -e $directory || -L $directory ]] || return 2
  validate_directory_chain "$directory"
  owner=$(stat -c %u "$directory") || return 1
  [[ $owner == "$runtime_uid" ]] || return 1
  [[ -e $path || -L $path ]] || return 2
  [[ -f $path && ! -L $path ]] || return 1
  file_owner=$(stat -c %u "$path") || return 1
  [[ $file_owner == "$runtime_uid" ]] || return 1
  {
    IFS= read -r saved_base
    IFS= read -r saved_volume
    if IFS= read -r _extra; then return 1; fi
  } < "$path"
  [[ $saved_base == "$CFG_BASE_URL" ]] || return 1
  [[ $saved_volume =~ ^[1-9][0-9]*$ ]] && (( 10#$saved_volume <= 100 )) || return 1
  printf '%s\n' "$saved_volume"
}

write_media_mute_volume() {
  local volume=$1 path temp
  [[ $volume =~ ^[1-9][0-9]*$ ]] && (( 10#$volume <= 100 )) || return 1
  media_state_access_allowed || return 1
  prepare_media_state_directory || return 1
  path=$(media_mute_state_path) || return 1
  [[ ! -e $path || -f $path && ! -L $path ]] || return 1
  temp=$(mktemp "$MEDIA_STATE_DIR/.mute.XXXXXX") || return 1
  if ! printf '%s\n%s\n' "$CFG_BASE_URL" "$volume" > "$temp"; then
    rm -f -- "$temp"
    return 1
  fi
  if ! chmod 0600 "$temp" || ! mv -f -- "$temp" "$path"; then
    rm -f -- "$temp"
    return 1
  fi
}

clear_media_mute_volume() {
  local path
  media_state_access_allowed || return 1
  path=$(media_mute_state_path) || return 1
  validate_directory_chain "$(dirname "$path")"
  [[ ! -e $path || -f $path && ! -L $path ]] || return 1
  rm -f -- "$path"
}

plex_music_timeline_value() {
  local attribute=$1 command_id=$2 poll_url response remaining element value
  local timeline_pattern='<Timeline[[:space:]][^>]*>'
  local music_pattern='(^|[[:space:]])type="music"([[:space:]/>])'
  local attribute_pattern
  [[ -n $CFG_BASE_URL ]] || return 1
  poll_url="$CFG_BASE_URL/player/timeline/poll?wait=0&commandID=$command_id"
  response=$(media_curl \
    --header 'X-Plex-Client-Identifier: a2dpilot' \
    --header 'X-Plex-Device-Name: A2DPilot' \
    "$poll_url") || return 1
  attribute_pattern="(^|[[:space:]])${attribute}=\"([0-9]+)\"([[:space:]/>])"
  remaining=$response
  while [[ $remaining =~ $timeline_pattern ]]; do
    element=${BASH_REMATCH[0]}
    remaining=${remaining#*"$element"}
    [[ $element =~ $music_pattern ]] || continue
    if [[ $element =~ $attribute_pattern ]]; then
      value=${BASH_REMATCH[2]}
      printf '%s\n' "$value"
      return 0
    fi
  done
  return 1
}

expand_player_state_tokens() {
  local template=$1 command_id=$2 value read_status
  EXPANDED_MEDIA_TEMPLATE=
  MEDIA_STATE_ACTION=
  if [[ $template == *'{volume-up}'* || $template == *'{volume-down}'* ]]; then
    value=$(plex_music_timeline_value volume "$command_id") || return 1
    [[ $value =~ ^[0-9]+$ ]] && (( 10#$value <= 100 )) || return 1
    if [[ $template == *'{volume-up}'* ]]; then
      MEDIA_STATE_ACTION=clear
      value=$((10#$value + VOLUME_STEP))
      (( value <= 100 )) || value=100
      template=${template//\{volume-up\}/$value}
    fi
    if [[ $template == *'{volume-down}'* ]]; then
      (( 10#$value == 0 )) || MEDIA_STATE_ACTION=clear
      value=$((10#$value - VOLUME_STEP))
      (( value >= 0 )) || value=0
      template=${template//\{volume-down\}/$value}
    fi
  fi
  if [[ $template == *'{mute-toggle}'* ]]; then
    value=$(plex_music_timeline_value volume "$command_id") || return 1
    [[ $value =~ ^[0-9]+$ ]] && (( 10#$value <= 100 )) || return 1
    if (( 10#$value > 0 )); then
      MEDIA_STATE_ACTION=save:$((10#$value))
      value=0
    else
      if value=$(read_media_mute_volume); then
        MEDIA_STATE_ACTION=clear
      else
        read_status=$?
        (( read_status == 2 )) || return 1
        value=$((VOLUME_STEP * 3))
      fi
    fi
    template=${template//\{mute-toggle\}/$value}
  fi
  if [[ $template == *'{shuffle-toggle}'* ]]; then
    value=$(plex_music_timeline_value shuffle "$command_id") || return 1
    [[ $value == 0 || $value == 1 ]] || return 1
    value=$((1 - value))
    template=${template//\{shuffle-toggle\}/$value}
  fi
  if [[ $template == *'{repeat-cycle}'* ]]; then
    value=$(plex_music_timeline_value repeat "$command_id") || return 1
    case $value in
      0) value=2 ;;
      2) value=1 ;;
      1) value=0 ;;
      *) return 1 ;;
    esac
    template=${template//\{repeat-cycle\}/$value}
  fi
  EXPANDED_MEDIA_TEMPLATE=$template
}

player_control_action() {
  local media_key=${1:-} stateful=0 lock_wait
  if (( MEDIA_DEADLINE_INHERITED )); then
    MEDIA_DEADLINE_INHERITED=0
    media_remaining_seconds lock_wait || die "The media-control request timed out."
  else
    start_media_deadline || die "Could not start the media-control deadline."
  fi
  [[ $# -eq 1 ]] || die "Usage: a2dpilot player-control KEY_NAME"
  [[ $media_key =~ ^KEY_[A-Z0-9_]+$ ]] || die "Invalid media key name: $media_key"
  parse_config "$CONFIG_FILE" || die "$CONFIG_ERROR"
  if media_key_is_stateful "$media_key"; then
    stateful=1
    media_remaining_seconds lock_wait || die "The media-control request timed out."
    acquire_media_lock "$lock_wait" || die "Could not acquire the media-control lock."
  fi
  if ! media_url_for_key "$media_key"; then
    release_media_lock
    die "No valid media URL is configured for $media_key"
  fi
  if [[ $MEDIA_STATE_ACTION == save:* ]]; then
    write_media_mute_volume "${MEDIA_STATE_ACTION#save:}" || {
      release_media_lock
      die "Could not save the pre-mute volume."
    }
  fi
  if ! media_curl "$RESOLVED_MEDIA_URL"; then
    release_media_lock
    return 1
  fi
  if [[ $MEDIA_STATE_ACTION == clear ]]; then
    clear_media_mute_volume || {
      release_media_lock
      die "Could not clear the pre-mute volume."
    }
  fi
  (( stateful == 0 )) || release_media_lock
}

write_onboard_config_candidate() {
  local source=$1 destination=$2 analog_value=$3 hdmi_value=$4
  local raw line key analog_seen=0 hdmi_seen=0
  : > "$destination"
  while IFS= read -r raw || [[ -n $raw ]]; do
    line=$(trim "$raw")
    key=
    [[ $line == *=* ]] && key=$(trim "${line%%=*}")
    case $key in
      onboard-analog)
        analog_seen=1
        if [[ -n $analog_value ]]; then
          printf 'onboard-analog = %s\n' "$analog_value" >> "$destination"
        else
          printf '%s\n' "$raw" >> "$destination"
        fi
        ;;
      onboard-hdmi)
        hdmi_seen=1
        if [[ -n $hdmi_value ]]; then
          printf 'onboard-hdmi = %s\n' "$hdmi_value" >> "$destination"
        else
          printf '%s\n' "$raw" >> "$destination"
        fi
        ;;
      *) printf '%s\n' "$raw" >> "$destination" ;;
    esac
  done < "$source"
  if [[ -n $analog_value && $analog_seen == 0 ]]; then
    printf '\nonboard-analog = %s\n' "$analog_value" >> "$destination"
  fi
  if [[ -n $hdmi_value && $hdmi_seen == 0 ]]; then
    printf 'onboard-hdmi = %s\n' "$hdmi_value" >> "$destination"
  fi
}

list_onboard_audio_device_ids() {
  local output line id='' api='' class='' invalid=0
  local object_pattern='^[[:space:]]*id[[:space:]]+([0-9]+),[[:space:]]+type[[:space:]]+PipeWire:Interface:Device(/3)?[[:space:]]*$'
  local any_object_pattern='^[[:space:]]*id[[:space:]]+'
  local api_pattern='^[[:space:]]*device\.api[[:space:]]*=[[:space:]]*"([^"]+)"[[:space:]]*$'
  local class_pattern='^[[:space:]]*media\.class[[:space:]]*=[[:space:]]*"([^"]+)"[[:space:]]*$'
  ONBOARD_DEVICE_IDS=()
  output=$(bounded_user_pw_cli "$CFG_AUDIO_USER" "$ONBOARD_STATUS_TIMEOUT" ls Device 2>/dev/null) || return 1
  while IFS= read -r line; do
    if [[ $line =~ $object_pattern ]]; then
      if [[ -n $id ]]; then
        [[ -n $class ]] || invalid=1
        if [[ $class == Audio/Device ]]; then
          if [[ -z $api ]]; then
            invalid=1
          elif [[ $api == alsa ]]; then
            ONBOARD_DEVICE_IDS+=("$id")
          fi
        fi
      fi
      id=${BASH_REMATCH[1]}
      api=
      class=
    elif [[ $line =~ $any_object_pattern ]]; then
      invalid=1
    elif [[ $line =~ $api_pattern ]]; then
      [[ -n $id && -z $api ]] || invalid=1
      api=${BASH_REMATCH[1]}
    elif [[ $line =~ $class_pattern ]]; then
      [[ -n $id && -z $class ]] || invalid=1
      class=${BASH_REMATCH[1]}
    fi
  done <<< "$output"
  if [[ -n $id ]]; then
    [[ -n $class ]] || invalid=1
    if [[ $class == Audio/Device ]]; then
      if [[ -z $api ]]; then
        invalid=1
      elif [[ $api == alsa ]]; then
        ONBOARD_DEVICE_IDS+=("$id")
      fi
    fi
  fi
  (( invalid == 0 ))
}

inspect_onboard_audio_device() {
  local expected_id=$1 output line id='' type='' card='' form='' api='' class='' invalid=0
  local id_pattern='^[[:space:]]*id:[[:space:]]+([0-9]+)[[:space:]]*$'
  local type_pattern='^[[:space:]]*type:[[:space:]]+PipeWire:Interface:Device(/3)?[[:space:]]*$'
  local card_pattern='^[[:space:]]*api\.alsa\.card\.name[[:space:]]*=[[:space:]]*"([^"]+)"[[:space:]]*$'
  local form_pattern='^[[:space:]]*device\.form-factor[[:space:]]*=[[:space:]]*"([^"]+)"[[:space:]]*$'
  local api_pattern='^[[:space:]]*device\.api[[:space:]]*=[[:space:]]*"([^"]+)"[[:space:]]*$'
  local class_pattern='^[[:space:]]*media\.class[[:space:]]*=[[:space:]]*"([^"]+)"[[:space:]]*$'
  output=$(bounded_user_pw_cli "$CFG_AUDIO_USER" "$ONBOARD_STATUS_TIMEOUT" info "$expected_id" 2>/dev/null) || return 1
  while IFS= read -r line; do
    line=${line#\*}
    if [[ $line =~ $id_pattern ]]; then
      [[ -z $id ]] || invalid=1
      id=${BASH_REMATCH[1]}
    elif [[ $line =~ $type_pattern ]]; then
      [[ -z $type ]] || invalid=1
      type=device
    elif [[ $line =~ $card_pattern ]]; then
      [[ -z $card ]] || invalid=1
      card=${BASH_REMATCH[1]}
    elif [[ $line =~ $form_pattern ]]; then
      [[ -z $form ]] || invalid=1
      form=${BASH_REMATCH[1]}
    elif [[ $line =~ $api_pattern ]]; then
      [[ -z $api ]] || invalid=1
      api=${BASH_REMATCH[1]}
    elif [[ $line =~ $class_pattern ]]; then
      [[ -z $class ]] || invalid=1
      class=${BASH_REMATCH[1]}
    fi
  done <<< "$output"
  [[ $id == "$expected_id" && $type == device && $api == alsa &&
     $class == Audio/Device && -n $card ]] || invalid=1
  (( invalid == 0 )) || return 1
  ONBOARD_DEVICE_CARD=$card
  ONBOARD_DEVICE_FORM=$form
}

visible_onboard_devices() {
  local id
  ONBOARD_ANALOG_VISIBLE=0
  ONBOARD_HDMI_VISIBLE=0
  list_onboard_audio_device_ids || return 1
  for id in "${ONBOARD_DEVICE_IDS[@]}"; do
    inspect_onboard_audio_device "$id" || return 1
    [[ $ONBOARD_DEVICE_FORM == internal && \
       $ONBOARD_DEVICE_CARD == bcm2835*[Hh]eadphones* ]] && \
      ONBOARD_ANALOG_VISIBLE=$((ONBOARD_ANALOG_VISIBLE + 1))
    [[ $ONBOARD_DEVICE_FORM == internal && $ONBOARD_DEVICE_CARD == vc4-hdmi* ]] && \
      ONBOARD_HDMI_VISIBLE=$((ONBOARD_HDMI_VISIBLE + 1))
  done
  return 0
}

print_onboard_audio_status() {
  local target=${1:-all} analog_visible=unknown hdmi_visible=unknown
  if visible_onboard_devices; then
    analog_visible=$ONBOARD_ANALOG_VISIBLE
    hdmi_visible=$ONBOARD_HDMI_VISIBLE
  fi
  case $target in
    analog) note "Onboard analog: $CFG_ONBOARD_ANALOG ($analog_visible visible matching devices)" ;;
    hdmi) note "Onboard HDMI: $CFG_ONBOARD_HDMI ($hdmi_visible visible matching devices)" ;;
    all)
      note "Onboard analog: $CFG_ONBOARD_ANALOG ($analog_visible visible matching devices)"
      note "Onboard HDMI: $CFG_ONBOARD_HDMI ($hdmi_visible visible matching devices)"
      ;;
    *) return 1 ;;
  esac
}

audio_onboard_action() {
  local operation=${1:-} target=${2:-all} desired analog_value='' hdmi_value=''
  local candidate old_copy
  [[ $# -ge 1 && $# -le 2 ]] || \
    die "Usage: a2dpilot audio onboard {status|enable|disable} [analog|hdmi|all]"
  case $operation in
    status|enable|disable) ;;
    *) die "Unknown onboard-audio operation: $operation" ;;
  esac
  case $target in
    analog|hdmi|all) ;;
    *) die "Unknown onboard-audio target: $target" ;;
  esac
  require_root
  parse_config "$CONFIG_FILE" || die "$CONFIG_ERROR"
  if [[ $operation == status ]]; then
    print_onboard_audio_status "$target"
    return 0
  fi
  [[ -f $STATE_FILE ]] || die "A2DPilot is not installed."
  acquire_lock
  parse_config "$CONFIG_FILE" || {
    local error=$CONFIG_ERROR
    release_lock
    die "$error"
  }
  desired=enabled
  [[ $operation == disable ]] && desired=disabled
  [[ $target == hdmi ]] || analog_value=$desired
  [[ $target == analog ]] || hdmi_value=$desired
  if [[ ( -z $analog_value || $CFG_ONBOARD_ANALOG == "$analog_value" ) &&
        ( -z $hdmi_value || $CFG_ONBOARD_HDMI == "$hdmi_value" ) ]]; then
    release_lock
    note "Onboard audio policy is already current."
    return 0
  fi
  old_copy=$(mktemp "$STATE_DIR/.a2dpilot-config-old.XXXXXX") || {
    release_lock
    die "Could not snapshot the current configuration."
  }
  candidate=$(mktemp "$STATE_DIR/.a2dpilot-config-new.XXXXXX") || {
    rm -f -- "$old_copy"
    release_lock
    die "Could not create a configuration candidate."
  }
  cp -a -- "$CONFIG_FILE" "$old_copy"
  write_onboard_config_candidate "$CONFIG_FILE" "$candidate" "$analog_value" "$hdmi_value"
  chmod 0600 "$candidate"
  apply_locked_config_candidate "$candidate" "$old_copy" \
    "Onboard audio policy updated and applied."
}

audio_action() {
  local subject=${1:-}
  [[ $# -gt 0 ]] && shift
  case $subject in
    onboard) audio_onboard_action "$@" ;;
    *) die "Usage: a2dpilot audio onboard {status|enable|disable} [analog|hdmi|all]" ;;
  esac
}

devices_action() {
  require_root
  [[ $# -eq 0 ]] || die "devices does not accept arguments."
  parse_config "$CONFIG_FILE" || die "$CONFIG_ERROR"
  local priority=0 mac paired trusted connected a2dp avrcp codec policy name
  printf '%-4s %-17s %-7s %-7s %-9s %-5s %-6s %-10s %-24s %s\n' \
    '#' ADDRESS PAIRED TRUSTED CONNECTED A2DP AVRCP CODEC CODEC-POLICY NAME
  for mac in "${CFG_SPEAKERS[@]}"; do
    priority=$((priority + 1))
    paired=no; trusted=no; connected=no; a2dp=no; avrcp=no; codec=-
    device_paired "$mac" && paired=yes
    device_trusted "$mac" && trusted=yes
    device_connected "$mac" && connected=yes
    if a2dp_connected "$mac"; then
      a2dp=yes
      codec=$(a2dp_codec "$mac" 2>/dev/null || printf unknown)
    fi
    avrcp_connected "$mac" && avrcp=yes
    policy=$(speaker_codec_policy_display "$mac")
    name=$(device_name "$mac")
    printf '%-4s %-17s %-7s %-7s %-9s %-5s %-6s %-10s %-24s %s\n' \
      "$priority" "$mac" "$paired" "$trusted" "$connected" "$a2dp" "$avrcp" \
      "$codec" "$policy" "$name"
  done
  (( priority > 0 )) || note "No speakers are configured."
}

print_default_sink_status() {
  local active=none saved='' node effective result
  if [[ -f $STATE_DIR/active-speaker && ! -L $STATE_DIR/active-speaker ]]; then
    IFS= read -r saved < "$STATE_DIR/active-speaker" || saved=
    if valid_mac "$saved"; then
      saved=$(normalize_mac "$saved")
      if node=$(find_a2dp_node_id "$saved" "$DEFAULT_SELECTION_TIMEOUT") &&
         inspect_a2dp_sink_node "$saved" "$node" "$DEFAULT_SELECTION_TIMEOUT"; then
        active="$A2DP_SINK_NAME ($saved)"
      else
        active="unavailable ($saved)"
      fi
    fi
  fi
  if effective=$(pipewire_default_sink \
    "$CFG_AUDIO_USER" "$DEFAULT_SELECTION_TIMEOUT" effective); then
    result=0
  else
    result=$?
    effective=unknown
  fi
  (( result != 2 )) || effective=none
  note "Active managed sink: $active"
  note "Effective default sink: $effective"
}

status_action() {
  require_root
  [[ $# -eq 0 ]] || die "status does not accept arguments."
  if [[ -f $STATE_FILE ]]; then
    # SC1090: This is A2DPilot's generated state file in its root-only state
    # directory; its variable path also permits isolated test fixtures.
    # shellcheck disable=SC1090
    source "$STATE_FILE"
    note "Installation: ${INSTALL_PHASE:-unknown} ($STATE_FILE)"
  else
    note "Installation: absent"
  fi
  if parse_config "$CONFIG_FILE"; then
    note "Audio user: $CFG_AUDIO_USER"
    note "Controller: $CFG_CONTROLLER"
    note "Reconnect interval: ${CFG_RECONNECT_INTERVAL}s"
    note "Media controls: $CFG_MEDIA_CONTROLS"
    note "Base URL: ${CFG_BASE_URL:-none}"
    note "Media key mappings: ${#CFG_MEDIA_KEYS[@]}"
    print_onboard_audio_status all
    print_default_sink_status
    print_known_player_status
    devices_action
  else
    warn "$CONFIG_ERROR"
  fi
  note ""
  rfkill list bluetooth 2>&1 || true
  systemctl --no-pager --full status bluetooth.service triggerhappy.service \
    triggerhappy.socket a2dpilot.service 2>&1 || true
  if [[ -n ${CFG_AUDIO_USER:-} ]] && id "$CFG_AUDIO_USER" >/dev/null 2>&1; then
    as_user_systemctl "$CFG_AUDIO_USER" --no-pager --full status \
      pipewire.service pipewire.socket pipewire-pulse.service pipewire-pulse.socket \
      wireplumber.service 2>&1 || true
  fi
}

rollback_failed_install() {
  local rc=$1
  trap - ERR INT TERM
  note "Installation failed; attempting automatic rollback..."
  release_lock
  if "$SCRIPT_PATH" uninstall --keep-bonds; then
    note "Automatic rollback succeeded."
  else
    if [[ -f $STATE_FILE ]] && ! write_state_file failed; then
      warn "Could not mark the retained installation snapshot as failed."
    fi
    warn "Automatic rollback failed; recovery state remains at $STATE_DIR."
  fi
  exit "$rc"
}

cleanup_update_temps() {
  [[ -z ${UPDATE_CANDIDATE:-} ]] || rm -f -- "$UPDATE_CANDIDATE"
  [[ -z ${UPDATE_PREVIOUS:-} ]] || rm -f -- "$UPDATE_PREVIOUS"
  UPDATE_CANDIDATE=
  UPDATE_PREVIOUS=
}

restore_previous_update() {
  (( UPDATE_REPLACED )) || return 0
  [[ -f $UPDATE_PREVIOUS && ! -L $UPDATE_PREVIOUS ]] || return 1
  atomic_install_file "$UPDATE_PREVIOUS" "$INSTALLED_CLI" 0755 || return 1
  UPDATE_REPLACED=0
  if (( UPDATE_WAS_ACTIVE )); then
    systemctl restart a2dpilot.service || return 1
    [[ $(system_unit_active_bit a2dpilot.service) == 1 ]] || return 1
  fi
}

rollback_failed_update() {
  local rc=$1 message=$2 restored=1 retained_previous=
  trap '' HUP INT TERM
  printf 'ERROR: %s\n' "$message" >&2
  if (( UPDATE_REPLACED )); then
    note "Restoring the previous A2DPilot executable..."
    restore_previous_update || restored=0
    if (( restored )); then
      note "The previous A2DPilot executable was restored."
    elif (( UPDATE_REPLACED )) && [[ -f $UPDATE_PREVIOUS && ! -L $UPDATE_PREVIOUS ]]; then
      retained_previous=$UPDATE_PREVIOUS
      UPDATE_PREVIOUS=
      warn "Could not restore the previous A2DPilot executable; rollback copy retained at $retained_previous."
    else
      warn "Could not fully restore the previous A2DPilot executable and service."
    fi
  fi
  cleanup_update_temps
  release_lock
  exit "$rc"
}

update_action() {
  require_root
  local selector=branch ref=main selector_set=0 url phase previous_umask
  local candidate_version installed_version
  while [[ $# -gt 0 ]]; do
    case $1 in
      --tag|--branch|--sha)
        [[ $# -ge 2 ]] || die "$1 requires a value."
        (( selector_set == 0 )) || die "Update source selectors are mutually exclusive."
        selector=${1#--}
        ref=$2
        selector_set=1
        shift 2
        ;;
      --*) die "Unknown update option: $1" ;;
      *) die "Unexpected update argument: $1" ;;
    esac
  done

  case $selector in
    branch|tag) valid_update_ref "$ref" || die "Invalid $selector name: $ref" ;;
    sha)
      [[ $ref =~ ^[[:xdigit:]]{40}$ ]] || die "--sha requires a full 40-character hexadecimal commit SHA."
      ref=${ref,,}
      ;;
  esac
  url=$(update_source_url "$selector" "$ref") || die "Could not construct the update URL."

  ( validate_directory_chain "$STATE_DIR" ) || die "Unsafe A2DPilot state directory."
  phase=$(read_install_phase) || die "A2DPilot is not installed."
  [[ $phase == installed ]] || die "A2DPilot update requires an installed state; found '$phase'."
  validate_update_target || die "Refusing to update an unsafe installed executable."

  UPDATE_CANDIDATE=
  UPDATE_PREVIOUS=
  UPDATE_REPLACED=0
  UPDATE_WAS_ACTIVE=0
  previous_umask=$(umask)
  umask 077
  if ! UPDATE_CANDIDATE=$(mktemp /tmp/a2dpilot-update.XXXXXX); then
    umask "$previous_umask"
    die "Could not create a temporary update file."
  fi
  umask "$previous_umask"
  trap 'rollback_failed_update 129 "A2DPilot update was interrupted by a hangup."' HUP
  trap 'rollback_failed_update 130 "A2DPilot update was interrupted."' INT
  trap 'rollback_failed_update 143 "A2DPilot update was terminated."' TERM

  note "Downloading A2DPilot from $selector '$ref'..."
  if ! curl --fail --silent --show-error --location \
      --proto '=https' --proto-redir '=https' \
      --connect-timeout "$UPDATE_CONNECT_TIMEOUT" --max-time "$UPDATE_TOTAL_TIMEOUT" \
      --output "$UPDATE_CANDIDATE" "$url"; then
    rollback_failed_update 1 "Could not download A2DPilot from $url."
  fi
  [[ -f $UPDATE_CANDIDATE && ! -L $UPDATE_CANDIDATE && -s $UPDATE_CANDIDATE ]] || \
    rollback_failed_update 1 "The downloaded A2DPilot executable is empty or unsafe."
  update_candidate_has_bash_shebang "$UPDATE_CANDIDATE" || \
    rollback_failed_update 1 "The downloaded A2DPilot executable lacks the expected Bash shebang."
  bash -n "$UPDATE_CANDIDATE" || \
    rollback_failed_update 1 "The downloaded A2DPilot executable failed Bash syntax validation."
  read_a2dpilot_version "$UPDATE_CANDIDATE" candidate_version || \
    rollback_failed_update 1 \
      "The downloaded A2DPilot executable must declare exactly one valid A2DPILOT_VERSION."
  if a2dpilot_version_is_older "$candidate_version" "$A2DPILOT_VERSION"; then
    rollback_failed_update 1 \
      "Refusing to downgrade A2DPilot from $A2DPILOT_VERSION to $candidate_version. Back up $CONFIG_FILE, run 'sudo a2dpilot uninstall --keep-bonds', then install the older revision explicitly."
  fi

  acquire_lock
  phase=$(read_install_phase) || \
    rollback_failed_update 1 "A2DPilot was uninstalled while the update was downloading."
  [[ $phase == installed ]] || \
    rollback_failed_update 1 "A2DPilot installation state changed to '$phase' during the update."
  validate_update_target || \
    rollback_failed_update 1 "The installed executable became unsafe during the update."
  read_a2dpilot_version "$INSTALLED_CLI" installed_version || \
    rollback_failed_update 1 \
      "The installed A2DPilot executable does not declare exactly one valid A2DPILOT_VERSION."
  if a2dpilot_version_is_older "$candidate_version" "$installed_version"; then
    rollback_failed_update 1 \
      "Refusing to downgrade A2DPilot from $installed_version to $candidate_version. Back up $CONFIG_FILE, run 'sudo a2dpilot uninstall --keep-bonds', then install the older revision explicitly."
  fi

  if cmp -s -- "$UPDATE_CANDIDATE" "$INSTALLED_CLI" && update_target_metadata_current; then
    trap '' HUP INT TERM
    cleanup_update_temps
    release_lock
    trap - HUP INT TERM
    note "A2DPilot is already current for $selector '$ref'."
    return 0
  fi

  previous_umask=$(umask)
  umask 077
  if ! UPDATE_PREVIOUS=$(mktemp /tmp/a2dpilot-previous.XXXXXX); then
    umask "$previous_umask"
    rollback_failed_update 1 "Could not create the executable rollback file."
  fi
  umask "$previous_umask"
  install -o root -g root -m 0700 "$INSTALLED_CLI" "$UPDATE_PREVIOUS" || \
    rollback_failed_update 1 "Could not preserve the current A2DPilot executable."
  UPDATE_WAS_ACTIVE=$(checked_system_unit_active_bit a2dpilot.service) || \
    rollback_failed_update 1 "Could not determine the A2DPilot service state."
  # Bash may defer a trapped signal until the replacement command returns, so
  # mark the transaction for rollback before entering the atomic operation.
  UPDATE_REPLACED=1
  atomic_install_file "$UPDATE_CANDIDATE" "$INSTALLED_CLI" 0755 || \
    rollback_failed_update 1 "Could not replace the A2DPilot executable."

  if (( UPDATE_WAS_ACTIVE )); then
    if ! systemctl restart a2dpilot.service || \
       [[ $(system_unit_active_bit a2dpilot.service) != 1 ]]; then
      rollback_failed_update 1 "The updated A2DPilot service did not become active."
    fi
  fi

  trap '' HUP INT TERM
  UPDATE_REPLACED=0
  cleanup_update_temps
  release_lock
  trap - HUP INT TERM
  note "A2DPilot was updated successfully from $selector '$ref'."
}

infer_audio_user() {
  local requested=${1:-}
  if [[ -n $requested ]]; then
    printf '%s\n' "$requested"
  elif [[ -n ${SUDO_USER:-} && ${SUDO_USER:-} != root ]] && id "$SUDO_USER" >/dev/null 2>&1; then
    printf '%s\n' "$SUDO_USER"
  elif id pi >/dev/null 2>&1; then
    printf 'pi\n'
  else
    return 1
  fi
}

run_installed_a2dpilot() {
  "$INSTALLED_CLI" "$@"
}

post_install_onboarding() {
  local non_interactive=$1 onboarding_result
  if (( non_interactive == 0 )) && has_tty; then
    if (( ${#CFG_SPEAKERS[@]} > 0 )); then
      run_installed_a2dpilot pair --all || warn "Some configured speakers were not paired."
    fi
    run_installed_a2dpilot pair || warn "Interactive pairing did not complete."
    if parse_config "$CONFIG_FILE" && (( ${#CFG_SPEAKERS[@]} > 0 )); then
      note "Waiting for a configured Bluetooth speaker to become ready..."
      if wait_for_configured_speaker_default "$CONNECT_TIMEOUT"; then
        :
      else
        onboarding_result=$?
        if (( onboarding_result == 3 )); then
          [[ -n $DEFAULT_SINK_ERROR ]] || \
            DEFAULT_SINK_ERROR="Could not make the healthy Bluetooth sink PipeWire's default."
          warn "$DEFAULT_SINK_ERROR"
        else
          warn "No configured speaker became a healthy A2DP sink within ${CONNECT_TIMEOUT}s."
        fi
      fi
    fi
    offer_player_restarts "$CFG_AUDIO_USER" 1
  else
    if (( ${#CFG_SPEAKERS[@]} == 0 )); then
      note "No speakers are configured. Run 'sudo a2dpilot pair' or 'sudo a2dpilot config'."
    fi
    offer_player_restarts "$CFG_AUDIO_USER" 0
  fi
}

install_action() {
  require_root
  local requested_user='' non_interactive=0
  while [[ $# -gt 0 ]]; do
    case $1 in
      --user) [[ $# -ge 2 ]] || die "--user requires a value."; requested_user=$2; shift 2 ;;
      --non-interactive) non_interactive=1; shift ;;
      *) die "Unknown install option: $1" ;;
    esac
  done
  acquire_lock

  if [[ -e $STATE_FILE ]]; then
    local existing_phase
    existing_phase=$(
      # SC1090: STATE_FILE is generated by render_state_file and stored beneath
      # the validated root-only state directory, so it is safe to source here.
      # shellcheck disable=SC1090
      source "$STATE_FILE"
      printf '%s\n' "${INSTALL_PHASE:-installed}"
    ) || die "Could not read existing installation state."
    case $existing_phase in
      installing|failed)
        note "Recovering interrupted installation before retrying..."
        release_lock
        "$SCRIPT_PATH" uninstall --keep-bonds || die "Could not recover the interrupted installation."
        acquire_lock
        ;;
      *) release_lock; die "A2DPilot is already installed." ;;
    esac
  fi

  validate_managed_paths "$INSTALLED_CLI" "$CONFIG_FILE" "$SYSTEMD_UNIT" "$WIREPLUMBER_CONF" "$TRIGGER_CONF"
  [[ ! -e $STATE_DIR || -d $STATE_DIR && ! -L $STATE_DIR ]] || die "Unsafe state directory: $STATE_DIR"
  [[ ! -e $BACKUP_DIR || -d $BACKUP_DIR && ! -L $BACKUP_DIR ]] || die "Unsafe backup directory: $BACKUP_DIR"
  validate_directory_chain "$BACKUP_DIR"
  install -d -m 0700 "$STATE_DIR" "$BACKUP_DIR"
  chown root:root "$STATE_DIR" "$BACKUP_DIR"
  chmod 0700 "$STATE_DIR" "$BACKUP_DIR"
  : > "$STATE_DIR/created-files"
  : > "$STATE_DIR/replaced-files"
  : > "$STATE_DIR/created-bonds"

  local audio_user config_seed create_config=0
  local onboard_analog=enabled onboard_hdmi=enabled
  if [[ -e $CONFIG_FILE || -L $CONFIG_FILE ]]; then
    [[ -z $requested_user ]] || die "--user only applies when creating a new configuration."
    parse_config "$CONFIG_FILE" || die "$CONFIG_ERROR"
    audio_user=$CFG_AUDIO_USER
  else
    create_config=1
    audio_user=$(infer_audio_user "$requested_user") || \
      die "Could not infer an audio user; use install --user USER."
    id "$audio_user" >/dev/null 2>&1 || die "Audio user does not exist: $audio_user"
  fi

  record_system_service_states
  record_user_state "$audio_user"
  record_rfkill_state
  record_controller_state
  backup_file "$INSTALLED_CLI"
  backup_file "$CONFIG_FILE"
  backup_file "$SYSTEMD_UNIT"
  backup_file "$WIREPLUMBER_CONF"
  backup_file "$TRIGGER_CONF"
  write_state_file installing

  trap 'rollback_failed_install $?' ERR
  trap 'rollback_failed_install 130' INT
  trap 'rollback_failed_install 143' TERM

  if (( create_config && non_interactive == 0 )) && has_tty; then
    detect_install_onboard_audio || true
    if (( INSTALL_ONBOARD_ANALOG_AVAILABLE || INSTALL_ONBOARD_HDMI_AVAILABLE )); then
      tty_print '\nYou may optionally disable one or more onboard audio interfaces before Bluetooth pairing.\n'
    fi
    if (( INSTALL_ONBOARD_ANALOG_AVAILABLE )) && \
       tty_confirm 'Disable Raspberry Pi onboard analogue audio?'; then
      onboard_analog=disabled
    fi
    if (( INSTALL_ONBOARD_HDMI_AVAILABLE )) && \
       tty_confirm 'Disable Raspberry Pi onboard HDMI audio?'; then
      onboard_hdmi=disabled
    fi
  fi

  note "Installing BlueZ, PipeWire, WirePlumber, Triggerhappy, and A2DP codec support..."
  apt-get update
  DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "${PACKAGES[@]}"

  install -d -m 0755 "$(dirname "$INSTALLED_CLI")" "$(dirname "$SYSTEMD_UNIT")" \
    "$(dirname "$WIREPLUMBER_CONF")" "$(dirname "$TRIGGER_CONF")" "$(dirname "$CONFIG_FILE")"
  if [[ $SCRIPT_PATH != "$INSTALLED_CLI" ]]; then
    prepare_file_target "$INSTALLED_CLI"
    install -o root -g root -m 0755 "$SCRIPT_PATH" "$INSTALLED_CLI"
  else
    chmod 0755 "$INSTALLED_CLI"
  fi

  if [[ ! -e $CONFIG_FILE ]]; then
    config_seed=$(mktemp "$(dirname "$CONFIG_FILE")/.a2dpilot-config.XXXXXX")
    write_default_config "$config_seed" "$audio_user" "$onboard_analog" "$onboard_hdmi"
    mv -f -- "$config_seed" "$CONFIG_FILE"
  fi
  chown root:root "$CONFIG_FILE"
  chmod 0644 "$CONFIG_FILE"
  parse_config "$CONFIG_FILE" || die "$CONFIG_ERROR"

  prepare_file_target "$SYSTEMD_UNIT"
  write_systemd_unit "$SYSTEMD_UNIT"
  prepare_file_target "$WIREPLUMBER_CONF"
  write_wireplumber_config "$WIREPLUMBER_CONF"
  prepare_file_target "$TRIGGER_CONF"
  write_trigger_config "$TRIGGER_CONF" "$CFG_MEDIA_CONTROLS"

  systemctl daemon-reload
  unmask_units_all_scopes system '' "${SYSTEM_UNITS[@]}"
  ensure_audio_user "$CFG_AUDIO_USER"
  printf '%s\n' "$CFG_AUDIO_USER" > "$STATE_DIR/runtime-user"
  # Debian ships triggerhappy.socket as an alternative activation path for
  # triggerhappy.service. Starting both makes the socket fail when the service
  # already owns /run/thd.socket, so A2DPilot uses the direct service only.
  systemctl disable --now triggerhappy.socket
  systemctl enable --now bluetooth.service triggerhappy.service a2dpilot.service
  systemctl restart triggerhappy.service
  power_controller || warn "No usable Bluetooth controller is currently available."

  write_state_file installed
  trap - ERR INT TERM
  release_lock
  note "A2DPilot installed successfully for audio user $CFG_AUDIO_USER."

  post_install_onboarding "$non_interactive"
}

remove_created_bonds() {
  local controller mac extra failed=0
  [[ -s $STATE_DIR/created-bonds ]] || return 0
  while read -r controller mac extra; do
    if [[ -n $extra ]] || ! valid_mac "$controller" || ! valid_mac "$mac"; then
      warn "Invalid A2DPilot bond provenance entry; refusing to guess its controller."
      failed=1
      continue
    fi
    if ! device_info_on_controller "$controller" "$mac" >/dev/null 2>&1; then
      note "A2DPilot-created bond $mac is already absent from controller $controller."
    elif ! remove_bluetooth_device_on_controller "$controller" "$mac"; then
      warn "Could not remove A2DPilot-created bond $mac from controller $controller."
      failed=1
    else
      note "Removed A2DPilot-created bond $mac from controller $controller."
    fi
  done < "$STATE_DIR/created-bonds"
  (( failed == 0 ))
}

choose_bond_policy() {
  local requested=$1 answer controller mac extra
  if [[ ! -s $STATE_DIR/created-bonds ]]; then
    printf 'none\n'
    return 0
  fi
  if [[ $requested == keep ]]; then
    printf 'keep\n'
    return 0
  fi
  if [[ $requested == remove ]]; then
    printf 'remove\n'
    return 0
  fi
  if ! has_tty; then
    note "Keeping Bluetooth bonds (non-interactive uninstall)." >&2
    printf 'keep\n'
    return 0
  fi
  tty_print 'Bluetooth bonds created by A2DPilot:\n'
  while read -r controller mac extra; do
    [[ -z $extra ]] || continue
    if ! valid_mac "$controller" || ! valid_mac "$mac"; then
      continue
    fi
    tty_print '  %s via %s %s\n' "$mac" "$controller" \
      "$(device_name_on_controller "$controller" "$mac")"
  done < "$STATE_DIR/created-bonds"
  tty_print 'Remove these bonds? [y/N] '
  tty_read answer || answer=
  if [[ $answer == y || $answer == Y || $answer == yes || $answer == YES ]]; then
    printf 'remove\n'
  else
    printf 'keep\n'
  fi
}

restore_managed_files() {
  local path
  if [[ -f $STATE_DIR/created-files ]]; then
    while IFS= read -r path; do
      [[ -n $path ]] || continue
      allowed_managed_path "$path" || die "Refusing to remove unmanaged path during rollback: $path"
      validate_directory_chain "$(dirname "$path")"
      [[ ! -d $path || -L $path ]] || die "Refusing to remove a directory during rollback: $path"
      rm -f -- "$path"
    done < "$STATE_DIR/created-files"
  fi
  if [[ -f $STATE_DIR/replaced-files ]]; then
    while IFS= read -r path; do
      [[ -n $path ]] || continue
      allowed_managed_path "$path" || die "Refusing to restore unmanaged path: $path"
      [[ -e $BACKUP_DIR$path || -L $BACKUP_DIR$path ]] || die "Missing backup for $path"
      validate_directory_chain "$(dirname "$path")"
      [[ ! -d $path || -L $path ]] || die "Refusing to overwrite a directory during rollback: $path"
      rm -f -- "$path"
      install -d "$(dirname "$path")"
      cp -a -- "$BACKUP_DIR$path" "$path"
    done < "$STATE_DIR/replaced-files"
  fi
}

uninstall_action() {
  require_root
  local bond_request=ask bond_policy bond_failure=0 rollback_failure=0
  while [[ $# -gt 0 ]]; do
    case $1 in
      --keep-bonds) [[ $bond_request == ask ]] || die "Bond-policy flags are mutually exclusive."; bond_request=keep; shift ;;
      --remove-bonds) [[ $bond_request == ask ]] || die "Bond-policy flags are mutually exclusive."; bond_request=remove; shift ;;
      *) die "Unknown uninstall option: $1" ;;
    esac
  done
  [[ -f $STATE_FILE ]] || die "A2DPilot is not installed."
  acquire_lock
  bond_policy=$(choose_bond_policy "$bond_request")

  if systemctl show a2dpilot.service -p LoadState --value 2>/dev/null | grep -qv '^not-found$'; then
    systemctl disable --now a2dpilot.service || rollback_failure=1
  fi
  clear_recorded_default_sink || \
    warn "Could not clear A2DPilot's recorded PipeWire default sink."
  if [[ $bond_policy == remove ]]; then
    remove_created_bonds || bond_failure=1
  elif [[ $bond_policy == none ]]; then
    note "No A2DPilot-created bonds were recorded."
  else
    note "Bluetooth bonds were preserved."
  fi

  restore_managed_files || rollback_failure=1
  systemctl daemon-reload || rollback_failure=1
  restore_all_user_states || rollback_failure=1
  restore_controller_state
  restore_rfkill_state
  restore_system_service_states || rollback_failure=1

  note "APT-managed packages were retained."

  release_lock
  if (( rollback_failure )); then
    write_state_file failed || true
    die "Rollback was incomplete; recovery state remains at $STATE_DIR."
  fi
  rm -rf -- "$STATE_DIR"
  note "A2DPilot was uninstalled and managed system state was restored."
  (( bond_failure == 0 )) || die "System rollback succeeded, but one or more Bluetooth bonds could not be removed."
}

main() {
  local action=${1:-}
  [[ $# -gt 0 ]] && shift
  case $action in
    install) install_action "$@" ;;
    config) config_action "$@" ;;
    devices) devices_action "$@" ;;
    pair) pair_action "$@" ;;
    forget) forget_action "$@" ;;
    status) status_action "$@" ;;
    audio) audio_action "$@" ;;
    update) update_action "$@" ;;
    uninstall) uninstall_action "$@" ;;
    daemon) daemon_action "$@" ;;
    player-control) bounded_player_control_action "$@" ;;
    __player-control) player_control_worker_action "$@" ;;
    -h|--help|help|'') usage ;;
    *) usage >&2; die "Unknown command: $action" ;;
  esac
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  main "$@"
fi
